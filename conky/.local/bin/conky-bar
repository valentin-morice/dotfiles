#!/bin/bash
# conky-bar METRIC [WIDTH]
# Print a unicode bar with conky color directives. Intended for ${execpi ...}.
# Filled cells use ${color1}, empty cells use ${color3}, terminated with ${color}.

metric=$1
width=${2:-13}

read_cpu_snap() {
    awk '/^cpu / {print $2+$3+$4, $2+$3+$4+$5}' /proc/stat
}

case "$metric" in
    cpu)
        snap=/tmp/conky-cpubar-$USER
        read u2 t2 < <(read_cpu_snap)
        if [ -r "$snap" ]; then
            read u1 t1 < "$snap"
            if [ "${t2:-0}" -gt "${t1:-0}" ]; then
                pct=$(( 100 * (u2 - u1) / (t2 - t1) ))
            else
                pct=0
            fi
        else
            pct=0
        fi
        printf '%s %s\n' "$u2" "$t2" > "$snap"
        ;;
    mem)
        pct=$(free | awk '/^Mem:/ {printf "%.0f", $3/$2*100}')
        ;;
    bat)
        # energy-based % to match polybar's internal/battery calc;
        # snap to 100 at >=98% so the bar reads full whenever the label says FULL
        pct=$(awk -v n="$(cat /sys/class/power_supply/BAT0/energy_now)" -v f="$(cat /sys/class/power_supply/BAT0/energy_full)" 'BEGIN{p=n/f*100; printf "%.0f", (p>=98)?100:p}')
        ;;
    brt)
        pct=$(brightnessctl -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')
        ;;
    disk)
        pct=$(df --output=pcent / | awk 'NR==2 {gsub("%",""); print $1}')
        ;;
    *)
        pct=0
        ;;
esac

[ -z "$pct" ] && pct=0
[ "$pct" -gt 100 ] && pct=100
[ "$pct" -lt 0 ]   && pct=0

filled=$(( pct * width / 100 ))
empty=$(( width - filled ))

# Pick fill color: red below 20% (battery), blue for brightness, accent otherwise.
if [ "$metric" = "bat" ] && [ "$pct" -lt 20 ]; then
    fill_color='${color4}'
elif [ "$metric" = "brt" ]; then
    fill_color='${color1}'
else
    fill_color='${color2}'
fi

printf '%s' "$fill_color"
awk -v n=$filled 'BEGIN { for (i=0;i<n;i++) printf "█" }'
printf '${color3}'
awk -v n=$empty 'BEGIN { for (i=0;i<n;i++) printf "░" }'
printf '${color}'
