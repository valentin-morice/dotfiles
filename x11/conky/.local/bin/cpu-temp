#!/bin/bash
# Print CPU temperature (°C) by scanning /sys/class/hwmon for a known sensor.
for h in /sys/class/hwmon/hwmon*; do
    name=$(cat "$h/name" 2>/dev/null) || continue
    case "$name" in
        k10temp|coretemp|zenpower)
            t=$(cat "$h/temp1_input" 2>/dev/null) || continue
            [ -n "$t" ] && { printf '%d°C\n' $((t / 1000)); exit 0; }
            ;;
    esac
done
echo "—"
