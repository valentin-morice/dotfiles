#!/usr/bin/env bash
# Kill and relaunch GUI apps so those that read their theme only at launch
# (qt6ct Qt apps like zapzap, etc.) repaint after a light/dark switch, then
# restore each app to the state it was in:
#   * normal windows  -> back to their workspace (+ floating geometry if floated)
#   * tray-only apps   -> any reopened window is sent to the i3 scratchpad
#                         (apps with native start-in-tray relaunch hidden on
#                         their own, so usually no window appears to move).
#
# Covers normal windows (i3 IPC) and tray-only apps (xwininfo + _XEMBED_INFO).
# Split so theme-render can confirm BEFORE applying the theme, yet kill/relaunch
# AFTER (so relaunched apps read the freshly-rendered palette):
#   --ask <file>      collect + rofi confirm; on "Yes" write the snapshot to
#                     <file> (non-empty = confirmed), else leave it empty
#   --execute <file>  kill, relaunch, restore placement, then remove <file>
#   (no args)         ask, then execute detached — for standalone/manual use
#
# Snapshot lines (tab-separated, tagged by first field):
#   K <pid> <cwd> <b64 NUL-cmdline>                      relaunch (1 per pid)
#   P <class> <instance> <ws> <floating> <x> <y> <w> <h> placement (1 per window)
#   T <class> <instance>                                 tray app (1 per app)
# Placement matches relaunched windows by WM_CLASS; restore is best-effort.
# Needs: i3-msg, jq, xprop, rofi, base64; xwininfo for tray (degrades without).

set -euo pipefail

TAB=$'\t'; NL=$'\n'

# Class names (i3/X11 WM_CLASS "class") to never touch. Rofi is the prompt
# window itself. Add live-reloaders you'd rather not lose (they recolor without
# a restart anyway), e.g.: EXCLUDE_CLASSES=(Rofi Alacritty Code)
EXCLUDE_CLASSES=(Rofi)

# Process names (/proc/<pid>/comm) to never touch. Tray-bridge daemons proxy
# other apps' SNI icons into XEmbed windows, so those windows report the
# bridge's PID, not the real app's — killing the bridge would tear down every
# proxied icon and restart pointless infrastructure.
EXCLUDE_COMMS=(snixembed xembed-sni-proxy stalonetray trayer)

# Emit one TSV row per normal (i3-managed) window, with $ws bound to the
# window's workspace name. $1 is the jq array expression for the row's fields.
i3_windows() {
    local proj="$1"
    i3-msg -t get_tree 2>/dev/null | jq -r "
        .. | objects | select(.type==\"workspace\") | .name as \$ws
        | .. | objects
        | select(.window_properties? != null and .window_type==\"normal\")
        | $proj | @tsv"
}

# All window container ids -> stdout (used to tell relaunched windows apart
# from pre-existing survivors).
con_ids() {
    i3-msg -t get_tree 2>/dev/null \
        | jq -r '.. | objects | select(.window_properties? != null) | .id'
}

# ---------------------------------------------------------------------------
# Execute: tray settings -> kill -> relaunch -> restore placement. Detached.
# ---------------------------------------------------------------------------
do_execute() {
    local file="${1:?--execute needs a snapshot file}"
    local -a kill_pid=() kill_cwd=() kill_cmd_b64=()
    local -a place_class=() place_inst=() place_ws=() place_float=() place_x=() place_y=() place_w=() place_h=() place_done=()
    local -a tray_class=() tray_inst=()
    # The 8 scratch fields a..h mean different things per snapshot tag:
    #   K  a=pid       b=cwd       c=b64-cmdline
    #   P  a=class     b=instance  c=workspace  d=floating  e=x f=y g=w h=h
    #   T  a=class     b=instance
    local tag a b c d e f g h

    while IFS=$'\t' read -r tag a b c d e f g h; do
        case "$tag" in
            K) kill_pid+=("$a"); kill_cwd+=("$b"); kill_cmd_b64+=("$c") ;;
            P) place_class+=("$a"); place_inst+=("$b"); place_ws+=("$c"); place_float+=("$d")
               place_x+=("$e"); place_y+=("$f"); place_w+=("$g"); place_h+=("$h"); place_done+=(0) ;;
            T) tray_class+=("$a"); tray_inst+=("$b") ;;
        esac
    done < "$file"
    rm -f "$file"

    # Kill everything first (so the post-kill tree is a clean baseline).
    local i pid
    for i in "${!kill_pid[@]}"; do
        pid=${kill_pid[$i]}
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 20); do [ -d "/proc/$pid" ] || break; sleep 0.1; done
        [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null || true
    done

    # Baseline: container ids that survived the kills are NOT relaunched apps.
    local -A known=()
    local cid
    while read -r cid; do [ -n "$cid" ] && known[$cid]=1; done < <(con_ids)

    # Relaunch.
    local -a args
    for i in "${!kill_pid[@]}"; do
        mapfile -d '' args < <(printf '%s' "${kill_cmd_b64[$i]}" | base64 -d)
        [ "${#args[@]}" -gt 0 ] || continue
        [ -z "${args[-1]}" ] && unset 'args[-1]'          # drop trailing-NUL empty arg
        [ "${#args[@]}" -gt 0 ] || continue
        ( cd "${kill_cwd[$i]}" 2>/dev/null || cd "$HOME"; setsid "${args[@]}" >/dev/null 2>&1 & )
    done

    # Restore placement: poll for newly-appeared windows and move each back.
    [ "${#place_class[@]}" -eq 0 ] && [ "${#tray_class[@]}" -eq 0 ] && return
    local -A used=()
    local pending=${#place_class[@]} have_tray=${#tray_class[@]}
    # Normal windows get up to 10s to appear and be placed. Tray fallback is
    # best-effort: a tray window may appear late, or (with native start-in-tray)
    # never — so once all normal windows are placed, watch only briefly more for
    # stray tray windows instead of spinning out the full deadline.
    local deadline=$((SECONDS + 10))
    local tray_deadline=$((SECONDS + 3))
    local wclass winst curws ws placed
    while [ "$SECONDS" -lt "$deadline" ]; do
        while IFS=$'\t' read -r cid wclass winst curws; do
            [ -n "$cid" ] || continue
            [ -n "${known[$cid]:-}" ] && continue         # survivor, not relaunched
            [ -n "${used[$cid]:-}" ] && continue
            placed=0
            for i in "${!place_class[@]}"; do
                [ "${place_done[$i]}" = 1 ] && continue
                [ "${place_class[$i]}" = "$wclass" ] || continue
                [ -z "${place_inst[$i]}" ] || [ "${place_inst[$i]}" = "$winst" ] || continue
                place_done[$i]=1; used[$cid]=1; placed=1; pending=$((pending - 1))
                ws="${place_ws[$i]}"
                if [ "$curws" != "$ws" ]; then
                    if [[ "$ws" =~ ^[0-9]+$ ]]; then
                        i3-msg "[con_id=$cid] move to workspace number $ws" >/dev/null 2>&1 || true
                    else
                        i3-msg "[con_id=$cid] move to workspace \"$ws\"" >/dev/null 2>&1 || true
                    fi
                fi
                if [ "${place_float[$i]}" = user_on ]; then
                    i3-msg "[con_id=$cid] floating enable, move position ${place_x[$i]} px ${place_y[$i]} px, resize set ${place_w[$i]} px ${place_h[$i]} px" >/dev/null 2>&1 || true
                fi
                break
            done
            [ "$placed" = 1 ] && continue
            for i in "${!tray_class[@]}"; do              # tray fallback: hide window
                [ "${tray_class[$i]}" = "$wclass" ] || continue
                [ -z "${tray_inst[$i]}" ] || [ "${tray_inst[$i]}" = "$winst" ] || continue
                i3-msg "[con_id=$cid] move scratchpad" >/dev/null 2>&1 || true
                used[$cid]=1
                break
            done
        done < <(i3_windows '[.id, .window_properties.class, (.window_properties.instance // ""), $ws]')
        if [ "$pending" -le 0 ]; then
            [ "$have_tray" -eq 0 ] && break          # nothing tray-bound to wait for
            [ "$SECONDS" -ge "$tray_deadline" ] && break
        fi
        sleep 0.3
    done
}

# ---------------------------------------------------------------------------
# Collect restartable apps into `snapshot`. Sets globals: snapshot, n, skipped.
# ---------------------------------------------------------------------------
snapshot=""; n=0; skipped=0
collect() {
    command -v jq >/dev/null && command -v xprop >/dev/null || return 0

    local ancestors=" " p=$$
    while [ "$p" -gt 1 ]; do
        ancestors+="$p "
        p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 0)
        [ -n "$p" ] || break
    done

    local -A seen=() trayseen=() winpids=()

    # True if word $1 is in space-separated list $2. Both sides padded with
    # spaces so a match is whole-word only (e.g. "ab" doesn't match "abc").
    in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

    # consider <win|tray> <pid> <class> [win: <inst> <ws> <float> <x> <y> <w> <h>]
    #                                   [tray: <inst>]
    consider() {
        local role="$1" pid="$2" class="$3"; shift 3
        [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] || { skipped=$((skipped + 1)); return; }
        in_list "$class" "${EXCLUDE_CLASSES[*]}" && return
        local comm; comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
        in_list "$comm" "${EXCLUDE_COMMS[*]}" && return   # tray-bridge daemon
        in_list "$pid" "$ancestors" && return             # our own terminal

        if [ "$role" = win ]; then
            local inst="$1" ws="$2" floating="$3" x="$4" y="$5" w="$6" h="$7"
            winpids[$pid]=1
            snapshot+="P${TAB}${class}${TAB}${inst}${TAB}${ws}${TAB}${floating}${TAB}${x}${TAB}${y}${TAB}${w}${TAB}${h}${NL}"
        else
            # Tray-only apps only: if this pid also has a normal window, it's a
            # windowed app that happens to show a tray icon — restore the window,
            # don't force it to the tray.
            [ -n "${winpids[$pid]:-}" ] && return
            local inst="$1" key="$class|$1"
            if [ -z "${trayseen[$key]:-}" ]; then
                trayseen[$key]=1
                snapshot+="T${TAB}${class}${TAB}${inst}${NL}"
            fi
        fi

        [ -n "${seen[$pid]:-}" ] && return                # one relaunch per pid
        seen[$pid]=1
        local cwd b64
        cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || echo "$HOME")
        b64=$(base64 -w0 < "/proc/$pid/cmdline")
        snapshot+="K${TAB}${pid}${TAB}${cwd}${TAB}${b64}${NL}"
    }

    # (a) Normal managed windows + their placement, straight from i3's tree.
    local wid class inst ws floating x y w h pid
    while IFS=$'\t' read -r wid class inst ws floating x y w h; do
        [ -n "$wid" ] || continue
        pid=$(xprop -id "$wid" _NET_WM_PID 2>/dev/null | grep -oE '[0-9]+$' || true)
        consider win "$pid" "$class" "$inst" "$ws" "$floating" "$x" "$y" "$w" "$h"
    done < <(i3_windows '[.window, .window_properties.class, (.window_properties.instance // ""), $ws, .floating, .rect.x, .rect.y, .rect.width, .rect.height]')

    # (b) Tray-only apps: X windows carrying _XEMBED_INFO. Needs xwininfo.
    local id props
    if command -v xwininfo >/dev/null; then
        while read -r id; do
            [ -n "$id" ] || continue
            props=$(xprop -id "$id" _XEMBED_INFO _NET_WM_PID WM_CLASS 2>/dev/null) || continue
            grep -q '^_XEMBED_INFO(' <<<"$props" || continue
            pid=$(grep '^_NET_WM_PID(' <<<"$props" | grep -oE '[0-9]+$' || true)
            inst=$(grep '^WM_CLASS(' <<<"$props" | sed -E 's/.*= "([^"]*)".*/\1/')
            class=$(grep '^WM_CLASS(' <<<"$props" | sed -E 's/.*, "([^"]*)".*/\1/')
            consider tray "$pid" "$class" "$inst"
        done < <(xwininfo -root -tree 2>/dev/null | grep -oE '0x[0-9a-f]+' | sort -u)
    fi

    n=${#seen[@]}
    [ "$skipped" -gt 0 ] && echo "restart-gui-apps: skipped $skipped window(s) with no usable PID" >&2
    return 0
}

# rofi confirmation (default "No"; Escape = No). Returns 0 on "Yes". This gates
# the whole theme switch, so the wording is about applying the theme.
confirm() {
    [ -n "${DISPLAY:-}" ] && command -v rofi >/dev/null || return 1
    local mesg sel
    mesg="Apply theme? This closes &amp; reopens $n GUI app(s)."
    # config.rasi's mainbox includes mode-switcher (the modi tabs); in this
    # single-mode dmenu there are no tabs, so drop it to avoid an empty bar.
    sel=$(printf 'No\nYes\n' | rofi -dmenu -i -no-custom -lines 2 -p 'Apply theme' -mesg "$mesg" \
        -theme-str 'mainbox { children: [ inputbar, message, listview ]; }' || true)
    [ "$sel" = "Yes" ]
}

# ---------------------------------------------------------------------------
# Dispatch.
# ---------------------------------------------------------------------------
case "${1:-}" in
    --execute)
        do_execute "${2:?}"
        ;;
    --ask)
        out="${2:?--ask needs an output file}"
        : > "$out"
        collect
        [ "$n" -gt 0 ] || exit 0          # no apps to restart: let the switch proceed silently
        confirm || exit 10                # No/Escape: tell the caller to abort the whole switch
        printf '%s' "$snapshot" > "$out"
        ;;
    "")
        collect
        [ "$n" -gt 0 ] || exit 0
        confirm || exit 0
        tmpfile=$(mktemp)
        printf '%s' "$snapshot" > "$tmpfile"
        setsid "$0" --execute "$tmpfile" >/dev/null 2>&1 &
        ;;
    *)
        echo "usage: restart-gui-apps [--ask <file> | --execute <file>]" >&2
        exit 2
        ;;
esac
exit 0
