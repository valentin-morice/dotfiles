# Compositor — shadows only (no blur, no fading). Scoped to Conky and rofi
# via shadow-exclude so regular windows stay flat.
# Generated by theme-render; shadow color/opacity come from the active theme.
backend = "glx";
shadow = true;
shadow-radius = 18;
shadow-opacity = ${THEME_shadow_opacity};
shadow-color = "${THEME_shadow_color}";
shadow-offset-x = -18;
shadow-offset-y = -18;
shadow-exclude = [
    "class_g != 'Conky' && class_g != 'Rofi'"
];
vsync = true;
