#!/usr/bin/env bash
# Select the active theme and re-render every tool.
#
#   theme-switch <name>   activate palettes/<name>.sh
#   theme-switch toggle   cycle to the next available palette
#   theme-switch current  print the active theme name
#   theme-switch list     list available palettes

set -euo pipefail

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
PALETTES="$THEME_DIR/palettes"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/theme/current"

usage() { echo "usage: theme-switch <name|toggle|current|list>" >&2; exit 2; }

# Concurrency note: no lock here, deliberately. Serialization lives in
# theme-render (flock -o on the render lock); every render re-reads the pointer
# at its start, so however concurrent switches interleave, the last render to
# run reflects the final pointer. Holding a lock across set_theme from THIS
# process was tried and reverted: the fd leaked into daemons the render spawns,
# which then held the lock forever. The pointer write itself is atomic (mv), so
# a torn pointer can't happen either — worst case two rapid toggles collapse
# into one visible flip, which is fine for a double-tapped key.

list() {
    local f
    for f in "$PALETTES"/*.sh; do
        [ -e "$f" ] && basename "$f" .sh
    done
}

current() {
    local name=dark
    [ -r "$STATE" ] && IFS= read -r name < "$STATE" || true
    [ -n "$name" ] && [ -r "$PALETTES/$name.sh" ] || name=dark
    echo "$name"
}

set_theme() {
    local name="$1" tmp
    if [ ! -r "$PALETTES/$name.sh" ]; then
        echo "theme-switch: unknown theme '$name' (try: $(list | paste -sd, -))" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$STATE")"
    # Atomic pointer write — a torn write would silently fall back to dark.
    tmp="$(mktemp "$STATE.XXXXXX")"
    printf '%s\n' "$name" > "$tmp"
    mv -f "$tmp" "$STATE"
    "$THEME_DIR/theme-render"
}

toggle() {
    local cur next="" first="" prev=""
    cur=$(current)
    while read -r name; do
        [ -n "$first" ] || first="$name"
        if [ "$prev" = "$cur" ]; then next="$name"; break; fi
        prev="$name"
    done < <(list)
    # If current was the last entry (or unset), wrap to the first.
    [ -n "$next" ] || next="$first"
    [ -n "$next" ] || { echo "theme-switch: no palettes found" >&2; exit 1; }
    set_theme "$next"
}

case "${1:-}" in
    ""|-h|--help) usage ;;
    current)      current ;;
    list)         list ;;
    toggle)       toggle ;;
    *)            set_theme "$1" ;;
esac
