#!/usr/bin/env bash
# Render every tool's color config from the active theme's palette
# (resolved by load.sh; see theme-switch to change it).
# Reloads daemons that don't auto-reload, unless --no-reload is passed.
#
# shellcheck disable=SC2154
# ^ Every THEME_* var this script reads is exported by the palette sourced via
#   `. "$THEME_DIR/load.sh"` below; the source path is a variable so shellcheck
#   can't follow it (SC1090) and thus sees those vars as "never assigned"
#   (SC2154). Both are expected here, not bugs — disabled file-wide.

set -euo pipefail

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
TMPL="$THEME_DIR/templates"

reload=1
case "${1:-}" in
    --no-reload) reload=0 ;;
    "") ;;
    *) echo "usage: theme-render [--no-reload]" >&2; exit 2 ;;
esac

# Serialize renders. The WM's startup render can race a manual theme-switch, and
# a double-fired toggle keybind runs two renders at once; without a lock their
# reload signals interleave. Re-exec once under flock on a lock in the state dir;
# THEME_LOCK_HELD marks the re-exec'd instance so it doesn't recurse.
#
# -o (--close) is ESSENTIAL: it keeps the lock on the flock parent instead of an
# inherited fd. Without it, daemons backgrounded during the render (awww-daemon,
# the dunst fallback respawn, waybar) inherit the lock fd and hold the lock for
# their lifetime — permanently wedging every later theme switch. -w 15 turns any
# residual pathological wait into a loud failure instead of a silent hang.
if [ -z "${THEME_LOCK_HELD:-}" ] && command -v flock >/dev/null 2>&1; then
    LOCK="${XDG_CACHE_HOME:-$HOME/.cache}/theme/render.lock"
    mkdir -p "$(dirname "$LOCK")"
    exec env THEME_LOCK_HELD=1 flock -o -w 15 "$LOCK" "$0" "$@"
fi
# Don't leak the re-exec marker into daemons spawned below: a theme-switch or
# theme-render ever run as their descendant would see it and skip locking.
unset THEME_LOCK_HELD

# shellcheck disable=SC1090
. "$THEME_DIR/load.sh"

# Expose $HOME to templates as ${THEME_home} for the few places that need an
# absolute path (e.g. dunst's dmenu command, which isn't ~-expanded/PATH-searched).
export THEME_home="$HOME"

# Build SHELL-FORMAT arg for envsubst: only $THEME_* names get substituted, so
# other tools' ${...} config syntax passes through untouched.
vars=$(compgen -A export | grep '^THEME_' | sed 's/^/$/' | paste -sd ' ')

# Fail loudly if a template references a THEME_* var no palette defines. With the
# auto-generated SHELL-FORMAT list an unknown ${THEME_x} would otherwise pass
# through as literal text and silently emit a broken config (palette key-parity
# is easy to break); catch it before writing anything.
defined=$(compgen -A export | grep '^THEME_' | sort -u)
missing=""
while read -r name; do
    printf '%s\n' "$defined" | grep -qxF "$name" || missing="$missing $name"
done < <(grep -rhoE 'THEME_[A-Za-z0-9_]+' "$TMPL" | sort -u)
if [ -n "$missing" ]; then
    echo "theme-render: templates reference undefined palette var(s):$missing" >&2
    exit 1
fi

render() {
    local src="$TMPL/$1" dst="$2" real tmp
    # Resolve a symlinked target so we replace the real file, not the stow
    # symlink itself (stow may link individual files rather than folding a dir).
    real="$(readlink -f "$dst" 2>/dev/null || printf '%s' "$dst")"
    mkdir -p "$(dirname "$real")"
    # Atomic: render to a temp on the same filesystem, then rename over the
    # target. A crash / Ctrl-C / full disk can then never leave a half-written
    # config (these land inside the stow tree via the config symlinks).
    tmp="$(mktemp "$real.tmp-theme.XXXXXX")"
    if envsubst "$vars" < "$src" > "$tmp"; then
        mv -f "$tmp" "$real"
    else
        rm -f "$tmp"
        return 1
    fi
}

render sway.colors.conf.tmpl          "$HOME/.config/sway/colors.conf"
render swaynag.config.tmpl            "$HOME/.config/swaynag/config"
render waybar.config.jsonc.tmpl       "$HOME/.config/waybar/config"
render waybar.style.css.tmpl          "$HOME/.config/waybar/style.css"
render alacritty.colors.toml.tmpl     "$HOME/.config/alacritty/colors.toml"
render rofi.rasi.tmpl                 "$HOME/.config/rofi/config.rasi"
render zathurarc.tmpl                 "$HOME/.config/zathura/zathurarc"
render dunstrc.tmpl                   "$HOME/.config/dunst/dunstrc"
render fastfetch.config.jsonc.tmpl    "$HOME/.config/fastfetch/config.jsonc"
render gtk3.settings.ini.tmpl         "$HOME/.config/gtk-3.0/settings.ini"
render gtk4.settings.ini.tmpl         "$HOME/.config/gtk-4.0/settings.ini"
render delta.gitconfig.tmpl           "$HOME/.config/git/delta-theme.gitconfig"
render nvim.palette.lua.tmpl          "$HOME/.config/nvim/lua/theme/palette.lua"

# bluetuith (Bluetooth TUI). Rendered as a whole file rather than patched in
# place (cf. VSCodium below): it renders via tcell in truecolor, so named colors
# are fixed RGB and can't follow the terminal palette, and it rewrites its own
# config in koanf's HJSON style (unquoted, no commas) on exit, which jq can't
# parse. The template carries the keybindings too, so they're version-controlled
# here (like Claude's settings.json). bluetuith reads strict JSON fine (it's a
# subset of HJSON). It has no live theme reload, so colors apply on next launch.
render bluetuith.conf.tmpl            "$HOME/.config/bluetuith/bluetuith.conf"

# Wallpaper — applied even with --no-reload (the WM calls this at startup).
# Wayland: awww (a swww fork) owns the background via a persistent daemon, so the
# image swaps with no black frame even with an instant transition — swaybg can't
# (it draws once and exits, so sway drops the old surface before the new paints,
# flashing black). We use `--transition-type none` for a clean instant switch
# (the cross-fade lives in waybar's CSS instead). awww-daemon is started from the
# sway config; we also ensure it here (first install / not yet ready). awww has
# no `query` subcommand, so we detect readiness by retrying `awww img` until the
# daemon's socket answers (~2s cap). If awww isn't installed, fall back to
# swaybg via swaymsg.
if [ -n "${THEME_wallpaper:-}" ]; then
    if [ -n "${SWAYSOCK:-}" ] && command -v awww >/dev/null 2>&1; then
        if ! pgrep -x awww-daemon >/dev/null 2>&1; then
            awww-daemon >/dev/null 2>&1 &
        fi
        i=0
        until awww img "$THEME_wallpaper" --transition-type none >/dev/null 2>&1; do
            i=$((i + 1)); [ "$i" -ge 40 ] && break; sleep 0.05
        done
    elif [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null; then
        swaymsg output '*' bg "$THEME_wallpaper" fill >/dev/null 2>&1 || true
    fi
fi

# Claude Code follows the terminal background via its own "theme": "auto"
# setting, so no action is needed here — it picks up the new theme on the next
# session (no theme hot-reloads mid-session).

# VSCodium theme — settings.json is JSONC (comments / trailing commas), so jq
# would choke; replace the colorTheme value in place with sed instead, which
# preserves the rest of the file. VSCodium watches the file and recolors live.
vscode_settings="$HOME/.config/VSCodium/User/settings.json"
if [ -f "$vscode_settings" ]; then
    sed -i -E "s/(\"workbench\.colorTheme\"[[:space:]]*:[[:space:]]*\")[^\"]*\"/\1${THEME_vscode}\"/" "$vscode_settings"
fi

# GTK theme via gsettings — libadwaita/GTK4 apps follow color-scheme live. This
# is also what xdg-desktop-portal-gtk exposes as the freedesktop appearance
# color-scheme that Qt reads (see Qt note below). GTK3 apps recolor live via the
# xdg settings portal (xdg-desktop-portal-gtk emits SettingChanged); the
# rendered settings.ini files are the startup fallback. Harmless without dconf.
if command -v gsettings >/dev/null; then
    gi="org.gnome.desktop.interface"
    gsettings set "$gi" color-scheme "$THEME_gtk_color_scheme" 2>/dev/null || true
    gsettings set "$gi" gtk-theme    "$THEME_gtk_theme"        2>/dev/null || true
    gsettings set "$gi" icon-theme   "$THEME_gtk_icon"         2>/dev/null || true
    # Theme-independent, but set here (idempotent) so GTK apps that show code use
    # JetBrainsMono like the terminals instead of the Adwaita Mono default.
    gsettings set "$gi" monospace-font-name 'JetBrainsMono Nerd Font 11' 2>/dev/null || true
fi

# Qt — apps use QT_QPA_PLATFORMTHEME=xdgdesktopportal (.zshenv) and follow the
# freedesktop appearance "color-scheme" that the portal derives from the
# gsettings color-scheme set just above, flipping light/dark live (Qt 6.8+),
# with no restart. QtWebEngine maps it to prefers-color-scheme, so web-content
# apps (e.g. zapzap) flip too. Light/dark only by design — no per-app palette.

if [ "$reload" -eq 1 ]; then
    # Reload daemons that don't auto-reload. alacritty live-reloads its import;
    # fastfetch and VSCode read/watch on their own. dunst reloads in place
    # (dunst 1.13+) so visible notifications and the 20-entry history survive a
    # theme switch (a restart wiped them). Fall back to a restart if dunst isn't
    # up / lacks dunstctl.
    if ! { command -v dunstctl >/dev/null && dunstctl reload 2>/dev/null; }; then
        killall dunst 2>/dev/null || true
        # Wait for the old instance to release the org.freedesktop.Notifications
        # bus name before respawning; otherwise the new dunst can lose the race
        # to reacquire it and come up unable to receive notifications.
        for _ in $(seq 20); do pgrep -x dunst >/dev/null 2>&1 || break; sleep 0.05; done
        setsid dunst >/dev/null 2>&1 &
    fi

    # GTK3 daemons that start at login and then go deaf to the theme. Short-lived
    # GTK3 apps recolour live off the settings portal (see the gsettings block
    # above); these two read the theme once at startup and keep it for the life of
    # the process, so a switch leaves them wearing the old palette — the Thunar
    # daemon and the polkit password prompt, which is why a dark auth dialog kept
    # appearing over light apps. Restarting them is exactly what quitting and
    # relaunching by hand always did; it replaces the After=dconf.service ordering
    # the Thunar drop-in used to carry, which was never confirmed as the mechanism
    # and did not hold.
    #
    # The cost, stated plainly: open Thunar windows close, and a polkit prompt
    # open at this instant is cancelled. Both are fine at the moment you
    # deliberately flip the theme, and neither daemon has state worth keeping.
    if systemctl --user is-active --quiet thunar.service 2>/dev/null; then
        systemctl --user restart thunar.service >/dev/null 2>&1 || true
    fi

    __polkit_agent=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    if [ -x "$__polkit_agent" ] && pgrep -f "$__polkit_agent" >/dev/null 2>&1; then
        pkill -f "$__polkit_agent" 2>/dev/null || true
        # Same reason as dunst above: let the old process drop its registration
        # with polkitd before the new one tries to take it, or the session is left
        # with no agent and auth prompts silently never appear.
        for _ in $(seq 20); do pgrep -f "$__polkit_agent" >/dev/null 2>&1 || break; sleep 0.05; done
        setsid "$__polkit_agent" >/dev/null 2>&1 &
    fi
    unset __polkit_agent

    # zathura (PDF reader, both sessions) reads zathurarc only at startup and
    # doesn't watch the file — but its D-Bus interface re-sources it live, so
    # every `set` (UI chrome + recolor colours) re-applies with no restart or
    # flash, like VSCodium. Push SourceConfig to each running instance; each
    # owns the well-known name org.pwmt.zathura.PID-<pid>.
    if command -v busctl >/dev/null; then
        busctl --user list 2>/dev/null | awk '/^org\.pwmt\.zathura\.PID-/{print $1}' |
            while read -r zname; do
                busctl --user call "$zname" /org/pwmt/zathura \
                    org.pwmt.zathura SourceConfig >/dev/null 2>&1 || true
            done
    fi

    # nvim (like zathura above): reads the rendered palette only at colorscheme
    # load, but every instance serves RPC on $XDG_RUNTIME_DIR/nvim.<pid>.0, so
    # push a re-source — require("theme").reload() drops the cached palette
    # module and re-applies the colorscheme. Instances on another colorscheme
    # no-op; dead sockets fail silently. No restart, no flash.
    if command -v nvim >/dev/null; then
        for __nvim_sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
            [ -S "$__nvim_sock" ] || continue
            nvim --server "$__nvim_sock" \
                --remote-expr 'v:lua.require("theme").reload()' >/dev/null 2>&1 || true
        done
        unset __nvim_sock
    fi

    if [ -n "${SWAYSOCK:-}" ]; then
        # Apply the per-theme border colours LIVE via swaymsg
        # (client.* are runtime-settable, taking effect on all current/future
        # windows) instead of `swaymsg reload`. Reload would re-read the config —
        # but it also cycles swaybg, blanking the wallpaper to black for ~250ms,
        # which is the flash we're avoiding. The wallpaper itself was already
        # swapped gap-free by the `swaymsg output bg` above; launch.sh bumps
        # waybar's watched style overlay for the flicker-free CSS recolour. So a
        # theme switch touches nothing that resets — no reload, no flash. (No
        # xsettingsd: the xdg settings portal drives live GTK3/Qt recolour from
        # the gsettings call above.)
        swaymsg "$(grep -E '^[[:space:]]*client\.' "$HOME/.config/sway/colors.conf" | paste -sd ';')" >/dev/null 2>&1 || true
        "$HOME/.config/waybar/launch.sh"
    fi
fi
