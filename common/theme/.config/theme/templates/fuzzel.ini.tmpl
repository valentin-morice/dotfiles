# fuzzel.ini — RENDERED by theme-render from this template into
# ~/.config/fuzzel/fuzzel.ini. Do NOT edit the generated file; edit this
# template (layout) or the palette (colours: palettes/{light,dark}.sh).
#
# fuzzel is the launcher and the dmenu backend for the ~/.local/bin/fuzzel-*
# menus. Look: JetBrainsMono 11, 2px border, "❯" prompt, "Search" placeholder,
# 11 visible rows, no icons. fuzzel has no @import, so the whole file is
# rendered.
font=JetBrainsMono Nerd Font:size=11.5
dpi-aware=no
prompt=❯
placeholder=Search
icons-enabled=no
fields=name,generic,keywords
terminal=alacritty
# width is in CHARACTERS (fuzzel can't take pixels); ~72 ≈ rofi's fixed 720px.
width=72
lines=11
# Row height tuned to rofi's ~34px row pitch (rofi element padding 6 10 + spacing
# 2). NOTE: with dpi-aware=no fuzzel reads line-height in POINTS and scales by
# 96/72, so 25pt ≈ 33px on screen (the font-derived default was a cramped ~20px).
line-height=26
horizontal-pad=16
vertical-pad=14
inner-pad=12
tabs=4
layer=overlay

[colors]
background=${THEME_bg_bare}ff
text=${THEME_fg_soft_bare}ff
prompt=${THEME_secondary_bare}ff
placeholder=${THEME_muted_dim_bare}ff
input=${THEME_fg_soft_bare}ff
match=${THEME_accent_bare}ff
selection=${THEME_bg_sel_bare}ff
selection-text=${THEME_accent_bare}ff
selection-match=${THEME_accent_bare}ff
counter=${THEME_muted_dim_bare}ff
border=${THEME_border_bare}ff

[border]
width=2
radius=0
