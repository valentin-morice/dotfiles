[global]
    monitor = 0
    follow = mouse

    width = (250, 400)
    height = (0, 200)
    origin = top-right
    offset = (16, 16)

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 2
    frame_color = "${THEME_border_med}"
    gap_size = 14
    separator_color = frame
    sort = yes

    font = JetBrainsMono Nerd Font 10.5
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    # Resolve app-sent icon *names* (not just paths) against the themed icon set,
    # searching subdirs — otherwise name-only icons render as blank space.
    icon_theme = "${THEME_gtk_icon}"
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 20

    dmenu = ${THEME_home}/.local/bin/dunst-dmenu
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "${THEME_bg}"
    foreground = "${THEME_muted_warm}"
    highlight = "${THEME_highlight}"
    timeout = 5

[urgency_normal]
    background = "${THEME_bg}"
    foreground = "${THEME_fg}"
    highlight = "${THEME_highlight}"
    timeout = 8

[urgency_critical]
    background = "${THEME_bg}"
    foreground = "${THEME_fg}"
    frame_color = "${THEME_urgent}"
    highlight = "${THEME_urgent}"
    timeout = 0
