# qt6ct colour scheme, rendered by theme-render from the active palette. Only
# apps launched with QT_QPA_PLATFORMTHEME=qt6ct use it (today: qBittorrent,
# via its .desktop override in the applications package).
#
# Why qt6ct at all: under the xdgdesktopportal theme (.zshenv) Qt 6.11 flips
# its colorScheme hint live but keeps the palette it computed at launch, so a
# Qt Widgets window stays in its startup mode. qt6ct watches ~/.config/qt6ct
# and re-applies this palette to running apps, ~3s (its fixed debounce) after
# theme-render rewrites qt6ct.conf.
#
# One entry per QPalette::ColorRole, in enum order:
#   WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText,
#   ButtonText, Base, Window, Shadow, Highlight, HighlightedText, Link,
#   LinkVisited, AlternateBase, NoRole, ToolTipBase, ToolTipText,
#   PlaceholderText
# (21 entries; qt6ct fills in Accent from Highlight on Qt 6.6+.)
#
# Window is bg_alt and Base (lists, entries) is bg, so lists sit darker than
# the window chrome on dark and lighter on light, the usual arrangement for
# each. Base = bg also matches the terminal background. Tooltips use bg_alt2
# like waybar's. Disabled greys out the text roles to muted_dim and swaps the
# selection to the muted accent; inactive (unfocused window) matches active.
[ColorScheme]
active_colors=${THEME_fg}, ${THEME_bg_section}, ${THEME_bg_hover}, ${THEME_bg_section}, ${THEME_border_inactive}, ${THEME_border_med}, ${THEME_fg}, ${THEME_fg}, ${THEME_fg}, ${THEME_bg}, ${THEME_bg_alt}, ${THEME_border_med}, ${THEME_accent}, ${THEME_accent_text}, ${THEME_accent}, ${THEME_ansi_magenta}, ${THEME_bg_alt2}, ${THEME_bg}, ${THEME_bg_alt2}, ${THEME_fg}, ${THEME_muted}
inactive_colors=${THEME_fg}, ${THEME_bg_section}, ${THEME_bg_hover}, ${THEME_bg_section}, ${THEME_border_inactive}, ${THEME_border_med}, ${THEME_fg}, ${THEME_fg}, ${THEME_fg}, ${THEME_bg}, ${THEME_bg_alt}, ${THEME_border_med}, ${THEME_accent}, ${THEME_accent_text}, ${THEME_accent}, ${THEME_ansi_magenta}, ${THEME_bg_alt2}, ${THEME_bg}, ${THEME_bg_alt2}, ${THEME_fg}, ${THEME_muted}
disabled_colors=${THEME_muted_dim}, ${THEME_bg_section}, ${THEME_bg_hover}, ${THEME_bg_section}, ${THEME_border_inactive}, ${THEME_border_med}, ${THEME_muted_dim}, ${THEME_fg}, ${THEME_muted_dim}, ${THEME_bg}, ${THEME_bg_alt}, ${THEME_border_med}, ${THEME_accent_muted}, ${THEME_muted_dim}, ${THEME_accent}, ${THEME_ansi_magenta}, ${THEME_bg_alt2}, ${THEME_bg}, ${THEME_bg_alt2}, ${THEME_fg}, ${THEME_muted_dim}
