# Generated by theme-render from the active theme palette; never edit by hand.
# libadwaita apps follow gsettings color-scheme (set by theme-render); plain
# (non-libadwaita) GTK4 apps use Adwaita, which also tracks color-scheme. GTK4
# ignores gtk-application-prefer-dark-theme (a GTK3-only key — see gtk3 template),
# so it's deliberately omitted here.
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=${THEME_gtk_icon}
gtk-cursor-theme-name=Adwaita
