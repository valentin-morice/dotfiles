/* waybar style — rendered by theme-render from the active palette.
 * Reproduces the polybar look: flat (no rounding), text labels, semibold
 * JetBrainsMono, accent-tinted focused workspace, muted inactive ones. */

* {
    /* The "Mono" variant, NOT the plain "JetBrainsMono Nerd Font" the rest of
     * the setup uses, and the difference is load-bearing for the icons. In the
     * non-Mono face the patched icon glyphs keep their natural width but still
     * advance only one 600-unit cell, so they overhang whatever follows by up
     * to 557 units — measured on the SemiBold face actually rendering here:
     * right-side bearing runs -557 (wifi, eye-slash) to +57 (bluetooth), a
     * 614-unit spread, so one literal space after the icon produced a visibly
     * different gap per module. The Mono face fits every icon to the cell and
     * cuts that spread to 62 units (~1px at 14px), which is what keeps the
     * icons evenly spaced. Latin glyph metrics are identical between the
     * two faces (A: adv 600, RSB 42), so the text is unaffected. */
    font-family: "JetBrainsMono Nerd Font Mono";
    /* 14px — the long-standing by-eye value, restored. Deliberately NOT the
     * px = pt * 4/3 match with alacritty/rofi's 11.5pt (that would be 15.3px);
     * the computed match was tried and disliked. The icon modules set their
     * own font and size (ICON FONT below), so this only sizes the text. */
    font-size: 14px;
    font-weight: 600;
    min-height: 0;
}

/* Drop shadow: a layer surface can't paint outside itself, so the surface is
 * made transparent and 8px taller than the bar (height 40 in the config), and
 * the visible bar is the inner box, which casts its shadow into that strip. */
window#waybar {
    background-color: transparent;
}
window#waybar > box {
    margin-bottom: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.30);
    background-color: ${THEME_bg};
    color: ${THEME_fg};
    /* Cross-fade the bar surface on theme switch (reload_style_on_change applies
     * the new palette live, GTK3 honours the transition), 0.5s. The wallpaper
     * itself swaps instantly (awww --transition-type none) — only the bar fades.
     * Scoped to the bar surface — a transition on #workspaces button would also
     * smear the focused-accent block during normal workspace navigation, not
     * just on theme switch. */
    transition: background-color 500ms ease, color 500ms ease;
}

/* Workspaces — flat blocks. Inactive ones carry a very light gray fill so the
 * workspace group reads as a distinct region (with the AWAKE label sitting on
 * the bar bg just after it); the focused one gets the accent fill. */
#workspaces button {
    padding: 0 11px;
    margin: 0;
    border: none;
    border-radius: 0;
    color: ${THEME_muted};
    background-color: ${THEME_bg_section};
    /* kill Adwaita's default button gradient/inset so the block stays flat */
    background-image: none;
}
#workspaces button:hover {
    background-color: ${THEME_bg_hover};
    background-image: none;
    box-shadow: none;
    text-shadow: none;
}
/* .visible = displayed on some output but NOT holding keyboard focus, i.e. the
 * other screen's current workspace. It needs its own fill, not just brighter
 * text: with one bar per output, the unfocused screen's bar has no .focused
 * button at all, so this block is the only thing marking where that screen is
 * parked — and the accent/muted-accent contrast is what tells you at a glance
 * which display your keyboard is on. */
#workspaces button.visible {
    color: ${THEME_fg};
    background-color: ${THEME_accent_muted};
}
#workspaces button.focused {
    color: ${THEME_bg};
    background-color: ${THEME_accent};
}
#workspaces button.urgent {
    color: ${THEME_bg};
    background-color: ${THEME_urgent};
}

/* Right-side modules (module-margin spacing, padding-right 2 on the bar).
 * #mode and #idle_inhibitor are in here now: they moved out of modules-left
 * (workspaces sit there alone), so they take the 6px right-side padding rather
 * than the 11px that matches a workspace block.
 *
 * 6px a side = a 12px module gap (~15px between icon inks once the glyphs'
 * side bearings are added), about one icon width, like the macOS menu bar.
 * It was 9px (≈21px between inks); tightened with the 34 -> 32px bar. */
#mode,
#idle_inhibitor,
#clock,
#custom-mail,
#custom-recording,
#custom-dnd,
#custom-nightlight,
#pulseaudio,
#backlight,
#network,
#bluetooth,
#battery,
#tray {
    padding: 0 6px;
}
/* Nudge tray icons 1px down: their pixmaps sit optically high in the bar.
 * 2px, not 1, because the icon is centred in what's left of the height, so
 * top padding only moves it half as far. */
#tray {
    padding-top: 2px;
}

/* Power-profile icon. The clock is no longer centred (macOS layout: it sits at
 * the right end), so the old custom/clockpad counterweight and the min-width
 * pinning that balanced it are both gone — this is now an ordinary right-side
 * module. */
#custom-powerprofile {
    padding: 0 6px;
}

/* ICON FONT — every icon-only module renders in Material Symbols Outlined, at
 * one size. This is the whole sizing story now: the font draws every glyph on
 * the same 24dp grid, so there are no per-glyph size% spans in the config or
 * the custom module scripts any more (that was the md-* Nerd Font set's
 * workaround).
 *
 * The family is not optional. Material Symbols' codepoints sit in the Private
 * Use Area the Nerd Font also fills, so a module missing from this list would
 * draw its characters as unrelated Nerd Font glyphs. #mode and #clock are text
 * and stay on the JetBrainsMono face from `*`.
 *
 * font-weight picks the stroke: the variable font exposes named instances
 * Thin..Bold (wght 100-700, outline FILL 0, opsz 24), which fontconfig matches
 * like ordinary faces. Set explicitly so the global 600 doesn't silently apply.
 *
 * 18px puts the 20dp live area of the 24dp grid at ~15px, the same physical
 * size as the old md icons at 177% of 14px. The line box is 1.2em (ascent 1056
 * + descent 96 over 960 upem), ~22px, well inside the 32px bar. */
#idle_inhibitor,
#custom-powerprofile,
#custom-mail,
#custom-dnd,
#custom-nightlight,
#custom-recording,
#pulseaudio,
#backlight,
#network,
#bluetooth,
#battery {
    font-family: "Material Symbols Outlined";
    font-size: 18px;
    font-weight: 500;
}

/* ICON COLOUR — all of it, for every module, lives here and nowhere else.
 * The config template emits bare glyphs (no pango spans at all, so no inline
 * foreground), because inline markup beats CSS colour and would pin an icon to one value
 * across both themes. White-ish on dark, near-black on light, following the
 * palette. No accent blue on the icons.
 *
 * ONE COLOUR for every state icon — sleep, bluetooth, wifi, volume, dnd, night
 * light, recording and the rest never change colour with their state. There are
 * deliberately no .muted / .disconnected / .off colour rules: those states are
 * carried entirely by the GLYPH (crossed-out speaker, slashed wifi and
 * bluetooth, bedtime vs bedtime-off), the same distinct-shape-not-just-colour rule
 * the config follows for colour-blind readability. A state colour on any of
 * them would single that module out of the row.
 *
 * BATTERY IS THE ONE EXEMPTION (below), and only at critical: it turns red
 * under 10%. That is an alarm worth breaking the rule for; anything short of
 * it stays the same colour as every other icon.
 *
 * The workspace blocks keep the accent fill — that is the bar's one colour
 * accent and a different thing from an icon. */
#mode,
#idle_inhibitor,
#custom-powerprofile,
#custom-mail,
#custom-dnd,
#custom-nightlight,
#custom-recording,
#pulseaudio,
#backlight,
#network,
#bluetooth,
#battery,
#clock {
    color: ${THEME_fg};
}

/* Battery — the ONLY icon allowed to change colour, and only at critical
 * (<10%, the threshold in the config's `states` block, which is what stamps
 * this class). No amber warning step: one alarm, not a gradient. Text colour
 * only, no urgent background block — the icon is the gauge, and a filled block
 * would re-introduce exactly the single-module standout the rule above removes.
 *
 * Deliberately NOT scoped :not(.charging) — the reading is the charge level,
 * which is just as low the moment you plug in; the charging glyph ramp already
 * says power is connected. Higher specificity than the rule above (id+class),
 * so it wins regardless of source order.
 *
 * This is presentation, not alerting: batsignal.service raises dunst warnings
 * at 20/10% and suspends at 5%, independently of the bar. */
#battery.critical {
    color: ${THEME_urgent};
}
/* The clock is the right-most module now, so it carries the extra right-edge
 * breathing room (battery held it while it was last). */
#clock {
    padding-right: 14px;
}

/* Mail error state. imap-daemon only writes "?" once an outage has outlived its
 * grace window, so .stale means a real sustained failure, not the few seconds of
 * DNS-not-up-yet after a resume — those now leave the last good count in place
 * and never reach the bar. Dimmed so it reads as information rather than alarm.
 *
 * opacity, not color: `color` would collide with the #custom-mail foreground
 * rule above at equal specificity and depend on source order. opacity dims the
 * whole module regardless of what colours it. It takes no palette var, so it
 * stays byte-identical across light and dark like the other invariant rules. */
#custom-mail.stale {
    opacity: 0.55;
}

tooltip {
    background-color: ${THEME_bg_alt2};
    border: 1px solid ${THEME_border_med};
    padding: 2px 6px;
    transition: background-color 500ms ease, border-color 500ms ease;
}
/* Tooltip text: a normal-metrics sans-serif at normal weight. The bar's global
 * semibold JetBrainsMono Nerd Font otherwise renders tooltips bold and
 * vertically stretched in the auto-sized box (its tall icon-glyph line metrics);
 * the bar hides that with its fixed height, a tooltip can't. */
tooltip label {
    color: ${THEME_fg};
    font-family: sans-serif;
    font-weight: normal;
    font-size: 13px;
    transition: color 500ms ease;
}
