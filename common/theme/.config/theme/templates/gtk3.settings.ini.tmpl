# Generated by theme-render from the active theme palette; never edit by hand.
# Startup fallback for GTK3 apps; live switching comes via the xdg settings portal.
# dark = Adwaita-dark (gnome-themes-extra), light = built-in Adwaita.
# prefer-dark is pinned to 0 on BOTH themes: the theme NAME alone carries dark.
# GTK3 reads this key only here, once, at startup — nothing updates it live —
# so a process launched under dark kept it at 1, and after a switch to light it
# resolved "Adwaita" + prefer-dark to Adwaita's dark variant (waybar's tray
# menus stayed dark). With it at 0, Adwaita-dark <-> Adwaita flips both ways.
[Settings]
gtk-theme-name=${THEME_gtk_theme}
gtk-application-prefer-dark-theme=0
gtk-icon-theme-name=${THEME_gtk_icon}
gtk-cursor-theme-name=Adwaita
