# Generated by theme-render from the active theme palette; never edit by hand.
# xsettingsd is the XSETTINGS daemon i3 otherwise lacks: it pushes these to
# every running GTK app live, so a `theme-switch` recolors GTK apps (Thunar,
# etc.) with no restart. theme-render SIGHUPs xsettingsd to apply changes.
# GTK3 reloads its theme live on a NAME change, but not on the prefer-dark flag
# alone — so the dark palette sets ThemeName=Adwaita-dark (gnome-themes-extra).
# The prefer-dark flag is kept for apps that honour it.
Net/ThemeName "${THEME_gtk_theme}"
Net/IconThemeName "${THEME_gtk_icon}"
Gtk/CursorThemeName "Adwaita"
Gtk/ApplicationPreferDarkTheme ${THEME_gtk_prefer_dark}
