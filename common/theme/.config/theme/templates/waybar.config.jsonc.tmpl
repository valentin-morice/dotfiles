// waybar config — rendered by theme-render from the active palette.
// The module icons (volume/brightness/wifi/bluetooth/battery/mail) use pango
// <span> with the FROZEN colours (THEME_accent_fixed/THEME_muted_fixed), which
// are equal in every theme — so this rendered file is byte-identical between
// light and dark.
//
// Deliberate: per-theme colour lives entirely in style.css, which waybar
// live-applies via reload_style_on_change (below) with no reset/flicker. The
// config has no in-place reload, so anything theme-varying here would force the
// flickery SIGUSR2 reset. Layout/spacing live in style.css.
//
// ICONS: one family only — Material Design (md-*), never Font Awesome (fa-*).
// Mixing the two was the original mistake: they are drawn on different grids,
// so at one size some glyphs read tiny and others huge.
//
// Every icon span also carries an explicit size, computed — never guessed —
// from the glyph's own metrics in JetBrainsMonoNerdFontMono-SemiBold (the face
// that actually renders here):
//
//     size% = 155 * 600 / max(ink_width, ink_height)
//
// 600 units is md's native grid and 155% is the size of a glyph that fills it.
// 155 is also the ceiling: the font's line box is 1.32em, so at the bar's 34px
// height and 16px base, 160% would need 33.8px and start clipping.
// The Nerd Fonts patcher scaled some glyphs past that grid, which is what made
// the battery tower and the bluetooth rune look wrong; the formula undoes it:
//
//     most md- glyphs   600 units -> 155%
//     bell_off          610       -> 152%
//     weather_night     669       -> 139%
//     bluetooth_off     748       -> 124%
//     bluetooth, battery(discharging) 928 -> 100%
//
// Normalising on max(w,h) — the grid extent — rather than on height is the
// point: it corrects the over-scaled glyphs while leaving genuinely FLAT icons
// (eye 410, envelope 482) flat, since scaling those to a common height would
// blow them up sideways. Their shorter ink is md's intended rhythm, not a bug.
//
// Watch out for state pairs drawn at different scales — battery charging (570)
// vs discharging (928), bluetooth (928) vs bluetooth_off (748) — where each
// state's format string needs its own size or the icon jumps when state flips.
//
// To add an icon: measure it, apply the formula. Do not eyeball it.
{
    // Watch style.css and hot-apply CSS changes in place (no widget reset) —
    // this is what makes a theme switch recolour smoothly instead of flickering.
    "reload_style_on_change": true,

    "layer": "top",
    "position": "bottom",
    // 34 keeps the same proportion to the bar font (16px) that 30 had to the
    // old 14px, now that the font size is matched to alacritty/rofi.
    "height": 34,
    // macOS menu-bar layout: workspaces alone on the left, every status icon
    // collected on the right, clock last (right-most). Nothing is centred any
    // more, so the old custom/clockpad counterweight is gone.
    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    // Ordered like macOS: transient indicators, tray, then the fixed system
    // icons, then the clock. tray still sits left of the fixed icons so a
    // newly-added tray icon grows leftward instead of shoving them.
    "modules-right": ["sway/mode", "custom/recording", "custom/dnd", "custom/nightlight", "custom/mail", "tray", "idle_inhibitor", "custom/powerprofile", "pulseaudio", "backlight", "network", "bluetooth", "battery", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        // DYNAMIC: no persistent-workspaces, so a workspace appears when it has
        // a window and disappears when it empties. The bar therefore changes
        // width as you work — that is the point, not a regression.
        //
        // This only changes what is DISPLAYED. Which screen a workspace opens on
        // is sway's own pinning (`workspace $wsN output ...` in the sway config),
        // which is untouched, so the docked layout still behaves the same.
        //
        // all-outputs stays at its default of false: each bar lists only the
        // workspaces living on its own output, so the unfocused screen's bar has
        // no .focused button at all. That absence, plus the .visible fill in
        // style.css, is the "which screen am I typing on" cue.
        "all-outputs": false
    },

    // Binding-mode indicator (e.g. "resize"); auto-hidden in the default mode,
    // mirroring polybar's internal/i3 mode label. Accent-coloured like the
    // other text labels, hence rendered from the palette.
    "sway/mode": {
        "format": "<span foreground='${THEME_accent_fixed}'>{}</span>",
        "tooltip": false
    },

    "clock": {
        "interval": 10,
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // Power-profile icon — md-speedometer / _medium / _slow for performance /
    // balanced / power-saver; click opens the rofi-profile card panel. Refreshed instantly
    // by rofi-profile (pkill -RTMIN+11 waybar); interval is the external-change
    // fallback. Colour is theme-varying, so it lives in style.css.
    "custom/powerprofile": {
        "exec": "$HOME/.local/bin/waybar-powerprofile",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "on-click": "$HOME/.local/bin/rofi-profile"
    },

    "custom/mail": {
        "exec": "$HOME/.local/bin/waybar-mail",
        "interval": 5,
        "return-type": "json"
    },

    // Signal-driven status labels — each prints a frozen-colour span when active
    // and nothing (module hidden) when not, so they add no gap when idle and the
    // rendered config stays theme-invariant. Refreshed on demand: screenrecord
    // sends RTMIN+8, the DND bind RTMIN+9, nightlight-toggle RTMIN+10.
    // These labels only appear while active, which makes them ideal click
    // targets to turn the thing back off (helpers already exist).
    "custom/recording": {
        "exec": "$HOME/.local/bin/waybar-recording",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "$HOME/.local/bin/screenrecord"
    },
    "custom/dnd": {
        "exec": "$HOME/.local/bin/waybar-dnd",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "$HOME/.local/bin/dnd-toggle"
    },
    "custom/nightlight": {
        "exec": "$HOME/.local/bin/waybar-nightlight",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "$HOME/.local/bin/nightlight-toggle"
    },

    // Click-to-caffeinate: inhibits the swayidle timers while activated.
    // Both states use frozen colours (accent on, muted off), so the rendered
    // config stays byte-identical across themes.
    "idle_inhibitor": {
        "format": "{icon}",
        // Distinct ICON per state (not just colour) so caffeination is readable
        // at a glance and for colour-blind users: eye = idle inhibited (screen
        // forced on, "being watched"), eye-slash = normal idle/lock behaviour.
        "format-icons": {
            "activated": "<span foreground='${THEME_secondary_fixed}' size='155%'>󰈈</span>",
            "deactivated": "<span foreground='${THEME_muted_fixed}' size='155%'>󰈉</span>"
        },
        "tooltip-format-activated": "Idle inhibitor: On",
        "tooltip-format-deactivated": "Idle inhibitor: Off"
    },

    "pulseaudio": {
        "format": "<span foreground='${THEME_accent_fixed}' size='155%'>󰕾</span>",
        "format-muted": "<span foreground='${THEME_muted_fixed}' size='155%'>󰖁</span>",
        "tooltip-format": "Volume: {volume}%",
        // Scroll to change volume, click to mute — reuse the same helpers the
        // XF86Audio keys use (so the OSD toast + 100% clamp behave identically).
        "on-scroll-up": "$HOME/.local/bin/volume-notify up",
        "on-scroll-down": "$HOME/.local/bin/volume-notify down",
        "on-click": "$HOME/.local/bin/toggle-audio-mute"
    },

    // Screen backlight. No "device" key on purpose — waybar autodetects the sole
    // entry in /sys/class/backlight, which keeps this portable the same way the
    // battery module stays adapter-agnostic (here it'd be the amdgpu-specific
    // "amdgpu_bl1"). udev-driven, so no polling interval is needed.
    "backlight": {
        "format": "<span foreground='${THEME_accent_fixed}' size='155%'>󰃠</span>",
        "tooltip-format": "Brightness: {percent}%",
        // Scroll to adjust — reuses the helper the XF86MonBrightness keys call,
        // so the OSD toast and the 5% floor behave identically either way.
        "on-scroll-up": "$HOME/.local/bin/brightness-notify up",
        "on-scroll-down": "$HOME/.local/bin/brightness-notify down"
    },

    // Wi-Fi and Bluetooth are waybar modules again (nm-applet and blueman are
    // uninstalled, so the tray no longer carries them — it's for real graphical
    // apps only now). Click opens the same floating TUI as the $mod+n / $mod+b
    // bind: `--class` is alacritty's flag for the Wayland app_id (there is no
    // --app-id), and it must stay in sync with sway's for_window rules.
    "network": {
        "interval": 5,
        "format-wifi": "<span foreground='${THEME_accent_fixed}' size='155%'>󰖩</span>",
        "format-ethernet": "<span foreground='${THEME_accent_fixed}' size='155%'>󰈀</span>",
        "format-disconnected": "<span foreground='${THEME_muted_fixed}' size='155%'>󰖪</span>",
        "tooltip-format-wifi": "Network: {essid} ({signalStrength}%) — click for nmtui",
        "tooltip-format-ethernet": "Network: {ifname} — click for nmtui",
        "tooltip-format-disconnected": "Network: Disconnected — click for nmtui",
        "on-click": "alacritty --class netmenu-float -e nmtui"
    },

    "bluetooth": {
        // On/off is carried by a DIFFERENT GLYPH (plain rune vs slashed) plus the
        // muted colour, rather than the words ON/OFF — the bar is icon-only now.
        // Sizes differ because the two glyphs are drawn at different scales:
        // bluetooth ink is 928 units, bluetooth_off is 748 (see the icon note).
        "format": "<span foreground='${THEME_accent_fixed}' size='100%'>󰂯</span>",
        "format-off": "<span foreground='${THEME_muted_fixed}' size='124%'>󰂲</span>",
        "format-disabled": "<span foreground='${THEME_muted_fixed}' size='124%'>󰂲</span>",
        "format-connected": "<span foreground='${THEME_accent_fixed}' size='100%'>󰂯</span>",
        "tooltip-format": "Bluetooth: On — click for bluetui",
        "tooltip-format-connected": "Bluetooth: {device_alias} — click for bluetui",
        "tooltip-format-off": "Bluetooth: Off — click for bluetui",
        "tooltip-format-disabled": "Bluetooth: Off — click for bluetui",
        "on-click": "alacritty --class btmenu-float -e bluetui"
    },

    "battery": {
        // No hardcoded "bat"/"adapter": waybar autodetects the first battery +
        // adapter, so this stays portable (adapters vary: AC / AC0 / ADP1 ...).
        "interval": 5,
        // States only stamp CSS classes (warning/critical); the colour lives
        // in style.css like everything else theme-varying.
        "states": { "warning": 20, "critical": 10 },
        "tooltip-format": "Battery: {capacity}%",
        // Material's battery glyphs, which are drawn UPRIGHT — Font Awesome's
        // (fa-battery_*) are the horizontal laptop-style cell. Low -> high;
        // waybar splits capacity into len() equal buckets.
        "format-icons": {
            // Keyed by STATE. The charging glyphs are drawn at a different scale
            // to the discharging ones (570 vs 928 ink units), which is why the
            // charging format strings below carry size='155%' and the
            // discharging ones size='100%' — without that the icon would visibly
            // jump size the moment you plug in.
            "charging": ["󰢟", "󰂆", "󰂈", "󰂊", "󰂅"],
            "default": ["󰂎", "󰁻", "󰁾", "󰂀", "󰁹"]
        },
        "format": "<span foreground='${THEME_accent_fixed}' size='100%'>{icon}</span>",
        "format-charging": "<span foreground='${THEME_accent_fixed}' size='155%'>{icon}</span>",
        "format-full": "<span foreground='${THEME_accent_fixed}' size='100%'>{icon}</span>",
        // Critical (<10%) drops the icon's span entirely. That block turns urgent-red
        // in style.css, and inline pango markup beats CSS colour — so the frozen
        // blue icon would survive on the red fill and be unreadable, exactly the
        // trap documented for #custom-mail.stale. With no span, the whole label
        // (icon included) inherits the CSS `color` and follows the palette
        // (near-black on dark's #ff5555, near-white on light's #c8332b) while this
        // file stays byte-identical across themes.
        //
        // Precedence is format-<status>-<state> > format-<state> > format-<status>,
        // so format-critical would also swallow format-charging below 10%. It must
        // not: only `.critical:not(.charging)` gets the red fill, so a charging
        // battery keeps the normal bar bg — and there the blue icon (and the "+")
        // are still right. format-charging-critical restores it for that case.
        "format-critical": "<span size='100%'>{icon}</span>",
        "format-charging-critical": "<span foreground='${THEME_accent_fixed}' size='155%'>{icon}</span>"
    },

    // Positioned before volume in modules-right (not at the far right): the tray
    // is the only right-side module whose width changes at runtime, so keeping the
    // fixed labels (volume/brightness/wifi/bt/battery) anchored to its right stops them
    // layout-shifting when an icon appears — the tray grows leftward instead.
    // The gray fill (matching the inactive workspace blocks) lives in style.css.
    // spacing matches the block's 9px edge padding (#tray in style.css) so the
    // gap between icons equals the gap at the edges — a uniform 9px throughout.
    "tray": {
        "spacing": 9,
        "icon-size": 19
    }
}
