// waybar config — rendered by theme-render from the active palette.
// The accent-coloured text prefixes (WIFI/BT/VOL/BAT/MAIL) use pango <span>
// with the theme accent, so the whole file is theme-dependent (hence rendered,
// not stowed — like dunst/picom). Layout/spacing live in style.css.
{
    "layer": "top",
    "position": "bottom",
    "height": 29,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mail", "pulseaudio", "network", "bluetooth", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "clock": {
        "interval": 10,
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/mail": {
        "exec": "$HOME/.local/bin/waybar-mail",
        "interval": 5,
        "return-type": "json"
    },

    "pulseaudio": {
        "format": "<span foreground='${THEME_accent}'>VOL</span> {volume}%",
        "format-muted": "<span foreground='${THEME_accent}'>VOL</span> <span foreground='${THEME_muted}'>MUTED</span>"
    },

    "network": {
        "interval": 5,
        "format-wifi": "<span foreground='${THEME_accent}'>WIFI</span> {essid}",
        "format-ethernet": "<span foreground='${THEME_accent}'>ETH</span> {ifname}",
        "format-disconnected": "<span foreground='${THEME_accent}'>WIFI</span> <span foreground='${THEME_muted}'>OFFLINE</span>",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "disconnected",
        "on-click": "alacritty -e nmtui"
    },

    "bluetooth": {
        "format": "<span foreground='${THEME_accent}'>BT</span> ON",
        "format-off": "<span foreground='${THEME_accent}'>BT</span> <span foreground='${THEME_muted}'>OFF</span>",
        "format-disabled": "<span foreground='${THEME_accent}'>BT</span> <span foreground='${THEME_muted}'>OFF</span>",
        "format-connected": "<span foreground='${THEME_accent}'>BT</span> {device_alias}",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "alacritty -e bluetuith"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 5,
        "states": { "full": 98 },
        "format": "<span foreground='${THEME_accent}'>BAT</span> {capacity}%",
        "format-charging": "<span foreground='${THEME_accent}'>BAT</span> {capacity}%+",
        "format-full": "<span foreground='${THEME_accent}'>BAT</span> <span foreground='${THEME_muted}'>FULL</span>"
    },

    "tray": {
        "spacing": 12,
        "icon-size": 18
    }
}
