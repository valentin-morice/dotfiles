[Unit]
Description=IMAP IDLE notifier for the mail widget (waybar custom/mail)
# Deliberately session-independent: the daemon only writes a state file that the
# bar reads, so it's wired to default.target (starts with the user manager). The
# old `After=graphical-session.target` was inert here — WantedBy=default.target
# never pulls that target into the transaction — so it's dropped rather than left
# as a misleading no-op.

[Service]
Type=simple
# All config + credentials (IMAP_USER/IMAP_HOST/IMAP_PASS) come from this file (chmod 600).
EnvironmentFile=%h/.config/imap/imap.env
ExecStart=%h/.local/bin/imap-daemon
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
