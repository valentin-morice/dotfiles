[user]
	name = valentin
	email = valentin@morice.live
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM01UusCQCtFU00TsHQY2sDI9RGWj+ww8bY0i3Ig5CBB
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
# delta's dark/light is theme-rendered so diffs follow the live terminal theme
# (see theme/templates/delta.gitconfig.tmpl). Generated, gitignored, ~-expanded.
[include]
	path = ~/.config/git/delta-theme.gitconfig
[merge]
	conflictStyle = zdiff3
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
