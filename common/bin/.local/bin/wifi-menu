#!/bin/bash
# Rofi script-mode helper: connect to / scan for wifi via NetworkManager.
#   no args         -> print the menu (active network marked '*', [scan] row)
#   selection in $1 -> ROFI_INFO carries "<ssid>\t<security>"; act on it
# A new secured network needs a password via `rofi -dmenu -password`, but that
# can't run inline: while rofi runs us in script-mode it holds the keyboard grab,
# so a nested rofi can't grab it and dies silently (the bug where selecting a
# secured network just dropped). Instead we detach a `__pwprompt` re-exec of
# ourselves and emit nothing, so the parent rofi closes and releases the grab;
# the detached copy then prompts + connects, re-prompting on a wrong password.
# Modeled on the power-menu / profile-select script-mode convention.
set -eu

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a wifi "$@" || true; }

emit_menu() {
    printf '\0prompt\x1fwifi\n'
    printf '[scan]\0info\x1f__scan__\n'
    # SSID is requested last so that ':' inside an SSID (escaped by -e as '\:')
    # can't shift the IN-USE/SIGNAL/SECURITY fields; we rejoin and unescape it.
    #
    # An SSID can list several BSSIDs (one per AP). We dedup to the first row
    # (nmcli sorts by signal, so strongest) for the signal/security shown, but
    # the in-use '*' may sit on a weaker BSSID — so OR the in-use flag across all
    # rows of the SSID, else the connected network renders unmarked.
    nmcli -t -e yes -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list \
    | awk -F: '
        {
            inuse=$1; sig=$2; sec=$3
            ssid=$4; for (i=5;i<=NF;i++) ssid=ssid ":" $i
            gsub(/\\:/, ":", ssid)
            if (ssid=="") next
            if (!(ssid in seen)) {
                seen[ssid]=1; order[++n]=ssid
                sigv[ssid]=sig; secv[ssid]=(sec=="" ? "open" : sec)
            }
            if (inuse=="*") active[ssid]=1
        }
        END {
            # Mark the connected SSID as rofi’s "active" row so the theme tints it
            # (accent colour). Row 0 is [scan], so order[i] is entry index i.
            aidx=-1
            for (i=1;i<=n;i++) if (order[i] in active) aidx=i
            if (aidx>=0) printf "\0active\x1f%d\n", aidx
            for (i=1;i<=n;i++) {
                s=order[i]
                mark=(s in active) ? "* " : "  "
                printf "%s%s  (%s, %s%%)\0info\x1f%s\t%s\n", mark, s, secv[s], sigv[s], s, secv[s]
            }
        }'
}

# Try every path that needs no password. Returns 0 when fully handled
# (connected, or an open network that failed); returns 10 to signal the caller
# that a password prompt is required (which must be detached — see __pwprompt).
try_connect() {
    ssid="$1"; sec="$2"
    # Existing saved profile: just bring it up.
    if nmcli -t -f NAME con show 2>/dev/null | grep -Fxq "$ssid"; then
        if nmcli con up id "$ssid" >/dev/null 2>&1; then
            notify "Wi-Fi connected" "$ssid"
        else
            notify "Failed to connect" "$ssid"
        fi
        return 0
    fi
    if [ "$sec" = "open" ] || [ "$sec" = "--" ] || [ -z "$sec" ]; then
        # Open (or unknown — try without a password first).
        if nmcli -w 20 dev wifi connect "$ssid" >/dev/null 2>&1; then
            notify "Wi-Fi connected" "$ssid"; return 0
        fi
        [ "$sec" = "open" ] && { notify "Failed to connect" "$ssid"; return 0; }
    fi
    return 10
}

# Prompt for a password and connect, looping on failure. Runs detached (NOT in
# rofi script-mode), so it is free to spawn its own rofi for the masked input.
prompt_and_connect() {
    ssid="$1"
    # Wait for the script-mode rofi to exit and release the keyboard grab before
    # we open our own rofi (up to ~5s); otherwise our prompt can't grab input.
    for _ in $(seq 1 100); do pgrep -x rofi >/dev/null 2>&1 || break; sleep 0.05; done

    # The shared rofi theme is built for the multi-modi launcher: it pins the
    # mode-switcher (tabs) into mainbox, drops the `message` element, sets a
    # "Search" placeholder, and a "❯" prompt — all wrong for a password box.
    # Override per-prompt to show just the input + our message, clear the
    # placeholder, and label the prompt "Password" (the SSID is the message line
    # — embedding it in a sentence reads absurdly for networks named "Internet").
    overrides='mainbox { children: [ inputbar, message ]; }
               entry { placeholder: ""; }'

    mesg="$ssid"
    while :; do
        pw=$(rofi -dmenu -password -p "Password" -mesg "$mesg" -theme-str "$overrides" \
            </dev/null) || return 0
        [ -z "$pw" ] && return 0
        if nmcli -w 20 dev wifi connect "$ssid" password "$pw" >/dev/null 2>&1; then
            notify "Wi-Fi connected" "$ssid"
            return 0
        fi
        # Failure is usually a wrong password. nmcli leaves a half-created
        # profile caching the bad secret, which would block a retry — delete it
        # and re-prompt (the rofi message says it all; Esc cancels via `|| return`).
        nmcli con delete id "$ssid" >/dev/null 2>&1 || true
        mesg="$ssid — wrong password, try again (Esc to cancel)"
    done
}

# Detached re-exec entry point for the password prompt.
if [ "${1-}" = "__pwprompt" ]; then
    prompt_and_connect "$2"
    exit 0
fi

if [ "$#" -gt 0 ] && [ -n "$1" ]; then
    info="${ROFI_INFO-}"
    case "$info" in
        __scan__)
            nmcli dev wifi rescan >/dev/null 2>&1 || true
            sleep 2
            emit_menu
            exit 0
            ;;
    esac
    if [ -n "$info" ]; then
        ssid="${info%%$'\t'*}"
        sec="${info##*$'\t'}"
    else
        # Typed entry (e.g. a hidden SSID): treat the text as the SSID.
        ssid="$1"; sec=""
    fi
    rc=0
    try_connect "$ssid" "$sec" || rc=$?
    if [ "$rc" = 10 ]; then
        # Needs a password: detach so this script-mode invocation can exit and
        # let rofi close (freeing the grab), then prompt + connect out of band.
        setsid -f "$0" __pwprompt "$ssid" >/dev/null 2>&1 </dev/null
    fi
    exit 0
fi

emit_menu
