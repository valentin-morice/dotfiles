#!/usr/bin/env bash
# waybar custom/powerprofile module — shows one glyph for the active
# power-profiles-daemon profile (bolt=performance, contrast=balanced,
# eco=power-saver), with speed as the fallback. Deliberately NOT the rofi-profile
# card glyphs (fast-forward / adjust / minus-circle): matching them was tried on
# the bar and reverted to bolt/leaf, so the half-filled contrast circle is the
# only shape the two share. Click opens the rofi-profile card panel
# (on-click in the waybar config).
#
# Refreshed instantly by rofi-profile, which sends `pkill -RTMIN+11 waybar` after
# switching; the module's interval catches any external change. Colour lives in
# style.css (#custom-powerprofile) so it tracks the theme.
#
# Glyphs are UTF-8 octal escapes (pure-ASCII source, unmanglable), all Material
# Symbols like the rest of the bar. They are Private Use Area codepoints, so they
# only render as intended because style.css puts #custom-powerprofile in
# Material Symbols.
set -eu

p=$(powerprofilesctl get 2>/dev/null || echo balanced)
case "$p" in
    performance) g=$(printf '\356\250\213'); name=Performance  ;;  # U+EA0B bolt
    balanced)    g=$(printf '\356\254\267'); name=Balanced     ;;  # U+EB37 contrast
    power-saver) g=$(printf '\356\250\265'); name='Power Saver' ;; # U+EA35 eco
    *)           g=$(printf '\356\247\244'); name=$p           ;;  # U+E9E4 speed (fallback)
esac

# return-type json: text = the glyph, class = raw profile (for optional per-profile
# CSS), tooltip names the profile ("Power profile: Balanced") to match the other
# module tooltips, since the icon alone is ambiguous.
#
# Bare glyph, no span: font, size and colour all come from #custom-powerprofile
# in style.css, which is what keeps it matching the other icons and the theme.
printf '{"text":"%s","tooltip":"Power profile: %s","class":"%s"}\n' "$g" "$name" "$p"
