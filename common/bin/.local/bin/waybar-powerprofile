#!/usr/bin/env bash
# waybar custom/powerprofile module — shows one glyph for the active
# power-profiles-daemon profile (fast-forward=performance, adjust=balanced, minus-circle=saver),
# matching the rofi-profile card glyphs. This is the single glyph in the bar, a
# deliberate exception to the text-label rule. Click opens the rofi-profile card
# panel (on-click in the waybar config).
#
# Refreshed instantly by rofi-profile, which sends `pkill -RTMIN+11 waybar` after
# switching; the module's interval catches any external change. Colour lives in
# style.css (#custom-powerprofile) so it tracks the theme.
#
# Glyphs are UTF-8 octal escapes (pure-ASCII source, unmanglable).
set -eu

p=$(powerprofilesctl get 2>/dev/null || echo balanced)
case "$p" in
    performance) g=$(printf '\357\201\216'); name=Performance  ;;  # U+F04E fast-forward
    balanced)    g=$(printf '\357\201\202'); name=Balanced     ;;  # U+F042 adjust (half circle)
    power-saver) g=$(printf '\357\201\226'); name='Power Saver' ;; # U+F056 minus-circle
    *)           g=$(printf '\357\203\244'); name=$p           ;;  # U+F0E4 gauge (fallback)
esac

# return-type json: text = the glyph, class = raw profile (for optional per-profile
# CSS), tooltip names the profile ("Power profile: Balanced") to match the other
# module tooltips, since the icon alone is ambiguous.
#
# size='125%' matches every other bar icon (see waybar.config.jsonc.tmpl). The span
# sets ONLY the size — colour still comes from #custom-powerprofile in style.css,
# which is what keeps this glyph tracking the theme.
printf '{"text":"<span size=\\"125%%\\">%s</span>","tooltip":"Power profile: %s","class":"%s"}\n' "$g" "$name" "$p"
