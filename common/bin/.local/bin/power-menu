#!/bin/bash
# Session power actions — the action backend for rofi-power, which passes the
# picked entry as $1.
#
# Lock routes through `loginctl lock-session` (not the lock script directly) so
# it goes via swayidle's lock handler and matches $mod+Shift+x — one themed lock
# path. No Hibernate entry: swap is zram (RAM-backed), so hibernate can't work
# here.
set -e

# Confirm a machine-level destructive action, then run it — via rofi-confirm
# (floats over content; swaynag's bar reserved an exclusive zone and resized the
# tiling). Cancel is pre-selected; Escape cancels. Matches the $mod+Shift+e
# exit-sway confirm — shutdown/reboot shouldn't be a single fuzzy keystroke.
# args: <label> <command> <glyph-name> <message>
confirm_run() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v rofi >/dev/null; then
        exec "$HOME/.local/bin/rofi-confirm" "$1" "$2" "$3" "$4"
    else
        exec sh -c "$2"
    fi
}

case "$1" in
    lock)     exec loginctl lock-session ;;
    logout)   exec swaymsg exit ;;
    suspend)  exec systemctl suspend ;;
    reboot)   confirm_run 'Reboot' 'systemctl reboot' reboot 'Restart the machine?' ;;
    shutdown) confirm_run 'Shutdown' 'systemctl poweroff' shutdown 'Power off the machine?' ;;
    *)        echo "power-menu: unknown action '${1:-}' (lock|logout|suspend|reboot|shutdown)" >&2; exit 2 ;;
esac
