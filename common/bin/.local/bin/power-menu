#!/bin/bash
# Session power actions — the action backend for fuzzel-power, which passes the
# picked entry as $1.
#
# Lock routes through `loginctl lock-session` (not the lock script directly) so
# it goes via swayidle's lock handler and matches $mod+Shift+x — one themed lock
# path. No Hibernate entry: swap is zram (RAM-backed), so hibernate can't work
# here.
set -e

# Confirm a machine-level destructive action, then run it. The nag bar's button
# runs the command directly; Escape / dismiss cancels. swaynag is themed via
# templates/swaynag.config.tmpl. Matches the $mod+Shift+e exit-sway confirm —
# shutdown/reboot shouldn't be a single fuzzy keystroke.
confirm_run() {
    if [ -n "${SWAYSOCK:-}" ]; then
        exec swaynag -t warning -m "$1?" -B "$1" "$2"
    else
        exec sh -c "$2"
    fi
}

case "$1" in
    lock)     exec loginctl lock-session ;;
    logout)   exec swaymsg exit ;;
    suspend)  exec systemctl suspend ;;
    reboot)   confirm_run 'Reboot' 'systemctl reboot' ;;
    shutdown) confirm_run 'Shutdown' 'systemctl poweroff' ;;
esac
