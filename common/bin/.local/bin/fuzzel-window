#!/bin/sh
# Fuzzel window switcher for sway (replaces rofi's built-in `window` modus on
# the Wayland path). Lists leaf containers as "<app>   <title>" — mirroring the
# rofi window-format "{c}   {t}" — and focuses the picked one. The con_id is
# carried alongside the display text and recovered by line index (fuzzel
# --index), since fuzzel has no hidden per-row data.
set -eu

# id<TAB>app   title, for every leaf view (tiled or floating).
list=$(swaymsg -t get_tree | jq -r '
    [recurse(.nodes[]?, .floating_nodes[]?)
     | select((.type == "con" or .type == "floating_con")
              and .name != null
              and (.nodes | length) == 0
              and (.floating_nodes | length) == 0)]
    | .[] | "\(.id)\t\((.app_id // .window_properties.class) // "?")   \(.name)"')
[ -n "$list" ] || exit 0

idx=$(printf '%s\n' "$list" | cut -f2- | fuzzel --dmenu --index --prompt 'window ❯ ') || exit 0
[ -n "$idx" ] || exit 0

id=$(printf '%s\n' "$list" | awk -F'\t' -v n="$((idx + 1))" 'NR == n { print $1; exit }')
[ -n "$id" ] && swaymsg "[con_id=$id] focus" >/dev/null
