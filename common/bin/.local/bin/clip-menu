#!/bin/bash
# Rofi script-mode browser for the clipboard history that clip-notify records.
# - With no selection, lists history (most-recent first) for rofi.
# - On selection, rofi re-runs us with ROFI_INFO set to the entry's hash; we
#   load the stored full content back onto the CLIPBOARD with xclip.
#
# History lives in $STORE: one file per clip named by its sha1, plus an `index`
# of `hash<TAB>one-line-preview` lines. clip-notify is the writer; see it for
# the store format. Requires: wl-clipboard (Wayland) or xclip (X11).
set -e

STORE="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard"
INDEX="$STORE/index"

# Selection branch: ROFI_INFO carries the row's hash (set via the \0info field
# we emit below). Restore that clip's full content to the clipboard — via
# wl-copy on Wayland, xclip on X11 (side-by-side migration).
if [ -n "${ROFI_INFO:-}" ]; then
    if [ -f "$STORE/$ROFI_INFO" ]; then
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            wl-copy < "$STORE/$ROFI_INFO"
        else
            xclip -selection clipboard < "$STORE/$ROFI_INFO"
        fi
    fi
    exit 0
fi

# Listing branch.
printf '\0prompt\x1fclipboard\n'
printf '\0no-custom\x1ftrue\n'
[ -f "$INDEX" ] || exit 0
while IFS=$'\t' read -r hash disp; do
    [ -n "$hash" ] || continue
    printf '%s\0info\x1f%s\n' "$disp" "$hash"
done < "$INDEX"
