#!/bin/bash
set -eu
command -v pactl >/dev/null || { echo "toggle-mic-mute: pactl not found" >&2; exit 1; }
WIDTH=44

# --sync: only re-derive the LED from the current mute state (used at sway startup).
# The kernel trigger is detached by a udev rule, so this script is the LED's only owner.
if [ "${1:-}" = "--sync" ]; then
    if [ "$(pactl get-source-mute @DEFAULT_SOURCE@)" = "Mute: yes" ]; then
        brightnessctl -d platform::micmute s 1 >/dev/null 2>&1 || true
    else
        brightnessctl -d platform::micmute s 0 >/dev/null 2>&1 || true
    fi
    exit 0
fi

pactl set-source-mute @DEFAULT_SOURCE@ toggle
if [ "$(pactl get-source-mute @DEFAULT_SOURCE@)" = "Mute: yes" ]; then
    brightnessctl -d platform::micmute s 1 >/dev/null 2>&1 || true
    icon="󰍭"; right="muted"
else
    brightnessctl -d platform::micmute s 0 >/dev/null 2>&1 || true
    icon="󰍬"; right="on"
fi

left="$icon Microphone"
# Pad by visible characters: printf's %-*s counts bytes, so the 4-byte Nerd
# Font icon would leave the title 3 columns short of the box edge. ${#var}
# counts characters only in a UTF-8 locale, hence the LC_CTYPE pin.
LC_CTYPE=C.UTF-8
title="$left$(printf '%*s' $((WIDTH - ${#left} - ${#right})) '')$right"

notify-send -t 1500 -h string:x-canonical-private-synchronous:micmute "$title"
