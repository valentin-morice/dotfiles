#!/bin/bash
# Rofi script-mode helper for switching the power-profiles-daemon profile.
# - No args: list profiles; the active one is marked '*' and flagged as rofi's
#   "active" row so the theme tints it (accent), like wifi/bluetooth.
# - With a selection: ROFI_INFO carries the bare profile name; apply it.
set -e
if [ -n "$1" ]; then
    prof="${ROFI_INFO:-$1}"
    prof="${prof#\* }"; prof="${prof#  }"   # strip the mark if it came from display text
    powerprofilesctl set "$prof"
    exit 0
fi
powerprofilesctl list | awk '
    /^[[:space:]]*\*?[[:space:]]*[a-z-]+:$/ {
        isact = ($0 ~ /\*/)
        name = $0; gsub(/[*:[:space:]]/, "", name)
        n++; names[n] = name
        if (isact) { aidx = n - 1; found = 1 }   # 0-based row index (no rows precede)
    }
    END {
        if (found) printf "\0active\x1f%d\n", aidx
        for (i = 1; i <= n; i++) {
            mark = (found && i - 1 == aidx) ? "* " : "  "
            printf "%s%s\0info\x1f%s\n", mark, names[i], names[i]
        }
    }'
