#!/bin/bash
# Show a dunst notification whenever the clipboard changes.
#
# History storage is cliphist (started below): captures text AND images, and
# skips clips marked sensitive by password managers (x-kde-passwordManagerHint),
# so 1Password copies never persist. rofi-clip is the reader ($mod+c).
# Requires: wl-clipboard, cliphist.

PREVIEW_MAX=80

# handle <content>: dedup against the last seen clip (persisted to a file so the
# per-event subprocesses share it) and notify.
LASTFILE="${XDG_RUNTIME_DIR:-/tmp}/clip-notify.last"
handle() {
    local content="$1" hash last_hash="" chars lines preview summary
    [ -z "$content" ] && return

    hash=$(printf '%s' "$content" | sha1sum | cut -d' ' -f1)
    [ -r "$LASTFILE" ] && IFS= read -r last_hash < "$LASTFILE"
    [ "$hash" = "$last_hash" ] && return
    printf '%s\n' "$hash" > "$LASTFILE"

    chars=$(printf '%s' "$content" | wc -m)
    lines=$(printf '%s\n' "$content" | wc -l)

    preview=$(printf '%s' "$content" | tr '\n\t' '  ')
    [ "$chars" -gt "$PREVIEW_MAX" ] && preview="${preview:0:$PREVIEW_MAX}…"
    # dunstrc sets markup=full, so escape pango entities or a clip containing
    # &, <, or > (code, URLs) renders mangled or blank.
    preview=$(printf '%s' "$preview" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

    if [ "$lines" -gt 1 ]; then
        summary="Copied · ${chars} chars · ${lines} lines"
    else
        summary="Copied · ${chars} chars"
    fi

    notify-send -t 2000 -h string:x-canonical-private-synchronous:clipboard "$summary" "$preview"
}

# Internal: invoked by `wl-paste --watch` with the new clipboard text on stdin.
if [ "${1:-}" = "__wl_handle" ]; then
    # Never toast a password-manager clip: cliphist skips these for history, but
    # a toast would flash the secret on screen AND persist it in dunst's poppable
    # history. The hint MIME is on the current clipboard (this watch just fired).
    if wl-paste --list-types 2>/dev/null | grep -qi 'x-kde-passwordManagerHint'; then
        exit 0
    fi
    handle "$(cat)"
    exit 0
fi

# Single-instance lock — silently exit if another copy is already running.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/clip-notify.lock"
flock -n 9 || exit 0

# History: cliphist stores text and images (and skips password-manager clips on
# its own). One watcher per type, per cliphist's documented setup.
command -v cliphist >/dev/null 2>&1 && {
    wl-paste --type text  --watch cliphist store &
    wl-paste --type image --watch cliphist store &
}
# Toast on every text clip.
exec wl-paste --type text --watch "$0" __wl_handle
