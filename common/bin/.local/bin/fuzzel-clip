#!/bin/sh
# Fuzzel front-end for the clipboard history (Wayland/sway path; the i3/X11 path
# uses clip-menu as a rofi script-modus over the bespoke store). On Wayland
# cliphist owns storage — text AND images, with password-manager clips skipped —
# so this just pipes its list through fuzzel and copies the decoded pick.
#
# cliphist list emits "<id>\t<preview>" lines; `cliphist decode` reads a whole
# such line from stdin and recovers the full clip by its id (so identical
# previews never collide, and binary/image clips round-trip correctly).
set -eu

sel=$(cliphist list | fuzzel --dmenu --prompt 'clipboard ❯ ') || exit 0
[ -n "$sel" ] || exit 0   # cancelled — don't clobber the clipboard with empty
printf '%s\n' "$sel" | cliphist decode | wl-copy
