#!/bin/bash
# Adjust backlight brightness and show a dunst notification with a Nerd Font
# icon, a right-aligned percentage, and a progress bar.
# Usage: brightness-notify up|down

WIDTH=30

case "$1" in
    up)   brightnessctl set +5% >/dev/null ;;
    down) # Floor at 5% so repeated presses can't walk the backlight to 0 (a
          # black panel you then have to blind-fix).
          cur=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')
          if [ "${cur:-100}" -le 10 ]; then
              brightnessctl set 5% >/dev/null
          else
              brightnessctl set 5%- >/dev/null
          fi ;;
    *)    echo "usage: $0 up|down" >&2; exit 2 ;;
esac

pct=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')
left="󰃠 Brightness"
right="${pct}%"

title=$(printf '%-*s%s' $((WIDTH - ${#right})) "$left" "$right")

notify-send -t 1500 \
            -h string:x-canonical-private-synchronous:brightness \
            -h int:value:"$pct" \
            "$title"
