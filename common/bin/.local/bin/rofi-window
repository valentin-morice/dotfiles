#!/bin/sh
# rofi window switcher for sway. Lists leaf containers as "[ws] <app>   <title>"
# with the app's icon (app_id/class fed to rofi as an icon name and resolved
# through the icon theme, mirroring drun's iconned look), and focuses the picked
# one. The con_id is carried alongside the display text and recovered by line
# index (rofi -format i, 0-based), since rofi -dmenu returns the chosen text,
# not hidden per-row data.
set -eu

# id<TAB>icon<TAB>[workspace] app   title, for every leaf view (tiled or
# floating). icon is the raw app_id/class handed to rofi as an icon name; the
# workspace is carried by walking workspace nodes first, then their descendants
# (recurse loses parent context, so we bind $ws before descending).
list=$(swaymsg -t get_tree | jq -r '
    [recurse(.nodes[]?) | select(.type == "workspace")]
    | .[]
    | .name as $ws
    | [recurse(.nodes[]?, .floating_nodes[]?)
       | select((.type == "con" or .type == "floating_con")
                and .name != null
                and (.nodes | length) == 0
                and (.floating_nodes | length) == 0)]
    | .[]
    | ((.app_id // .window_properties.class) // "") as $app
    | "\(.id)\t\($app)\t[\($ws)] \(if $app == "" then "?" else $app end)   \(.name)"')
[ -n "$list" ] || exit 0

# Feed rofi each row as "<display>\0icon\x1f<name>" so -show-icons draws the app
# icon in the same 22px element-icon slot drun uses. A NUL byte can't live in a
# shell variable, so the icon markup is emitted straight into the pipe by awk
# (which also re-joins any tabs a title might contain back into the display).
idx=$(printf '%s\n' "$list" | awk -F'\t' '{
        disp = $3
        for (i = 4; i <= NF; i++) disp = disp "\t" $i
        printf "%s%cicon\37%s\n", disp, 0, $2
    }' | rofi -dmenu -show-icons -format 'i' -p 'window ❯') || exit 0
[ -n "$idx" ] || exit 0

id=$(printf '%s\n' "$list" | awk -F'\t' -v n="$((idx + 1))" 'NR == n { print $1; exit }')
[ -n "$id" ] && swaymsg "[con_id=$id] focus" >/dev/null
