configuration {
    modi: "drun,window";
    show-icons: false;
    font: "JetBrainsMono Nerd Font 11";
    drun-display-format: "{name}";
    drun-show-actions: false;
    drun-match-fields: "name,generic,keywords";
    window-format: "{c}   {t}";
    sidebar-mode: false;
    terminal: "alacritty";
    kb-row-tab: "";
    kb-element-next: "";
    kb-element-prev: "";
    kb-mode-next: "Tab";
    kb-mode-previous: "Shift+Tab";
}

@theme "/dev/null"
@import "~/.config/rofi/colors.rasi"

* {
    background:                  @bg;
    background-color:            transparent;
    foreground:                  @fg;
    text-color:                  @fg;

    normal-background:           @bg;
    normal-foreground:           @fg;
    selected-normal-background:  @bg-sel;
    selected-normal-foreground:  @accent;
    alternate-normal-background: @bg;
    alternate-normal-foreground: @fg;

    active-background:           @bg;
    active-foreground:           @accent;
    selected-active-background:  @bg-sel;
    selected-active-foreground:  @accent;
    alternate-active-background: @bg;
    alternate-active-foreground: @fg;

    urgent-background:           @bg;
    urgent-foreground:           @urgent;
    selected-urgent-background:  @urgent;
    selected-urgent-foreground:  @bg;
    alternate-urgent-background: @bg;
    alternate-urgent-foreground: @urgent;
}

window {
    background-color: @bg;
    border: 2;
    border-color: @border;
    width: 720;
    padding: 12;
}

mainbox {
    children: [ inputbar, listview, mode-switcher ];
    spacing: 10;
    padding: 0;
    background-color: @bg;
}

mode-switcher {
    background-color: @bg-alt;
    padding: 4;
    spacing: 4;
}

button {
    background-color: @bg-alt;
    text-color: @fg-dim;
    padding: 4 10;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-sel;
    text-color: @accent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    padding: 8 12;
    spacing: 8;
}

prompt {
    text-color: @secondary;
    background-color: transparent;
    str: "❯";
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-dim;
    text-color: @fg;
    background-color: transparent;
}

listview {
    lines: 11;
    columns: 1;
    spacing: 2;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    background-color: @bg;
}

element {
    padding: 6 10;
    spacing: 8;
    background-color: @bg;
    text-color: @fg;
}

element selected {
    background-color: @bg-sel;
    text-color: @accent;
}

/* "active" rows (e.g. the connected wifi) tinted accent. The explicit element
   text-colors above mask the legacy active-* palette vars, so set the active
   state colors directly here. */
element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.active {
    background-color: @bg-sel;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
