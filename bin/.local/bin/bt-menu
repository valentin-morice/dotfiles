#!/bin/bash
# Rofi script-mode helper: connect/disconnect & scan bluetooth via bluetoothctl.
#   no args         -> list paired devices (connected marked '*' + accent tint) + [scan] row
#   selection in $1 -> ROFI_INFO carries the device MAC; toggle connect/disconnect
# [scan] runs a timed discovery, then lists everything found so a new device can
# be paired+trusted+connected in one pick.
# Modeled on the power-menu / profile-select script-mode convention.
set -eu

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a bluetooth "$@" || true; }

connected() { bluetoothctl info "$1" 2>/dev/null | grep -q "Connected: yes"; }
paired()    { bluetoothctl info "$1" 2>/dev/null | grep -q "Paired: yes"; }

# `bluetoothctl devices [Paired]` prints: "Device AA:BB:.. Name with spaces"
emit_devices() {
    # $1 = row index of the first device (callers prepend a [scan] row or not);
    # the rest are bluetoothctl args (e.g. "devices Paired"), intentionally
    # unquoted so multi-word forms word-split into separate arguments.
    #
    # Connected devices are marked '*' AND flagged as rofi "active" rows so the
    # theme tints them. We buffer first (a NUL-bearing row can't be captured in a
    # shell var, but plain mac/name/state can) to emit one \0active line with all
    # connected indices — several devices can be connected at once.
    base=$1; shift
    macs=(); names=(); conns=()
    while read -r _ mac name; do
        [ -n "$mac" ] || continue
        macs+=("$mac"); names+=("$name")
        if connected "$mac"; then conns+=(1); else conns+=(0); fi
    done < <(bluetoothctl $* 2>/dev/null)

    actidx=""
    for j in "${!macs[@]}"; do
        [ "${conns[$j]}" = 1 ] && actidx="${actidx:+$actidx,}$((base + j))"
    done
    [ -n "$actidx" ] && printf '\0active\x1f%s\n' "$actidx"

    for j in "${!macs[@]}"; do
        if [ "${conns[$j]}" = 1 ]; then mark="* "; else mark="  "; fi
        printf '%s%s\0info\x1f%s\n' "$mark" "${names[$j]}" "${macs[$j]}"
    done
}

emit_menu() {
    printf '\0prompt\x1fbluetooth\n'
    printf '[scan]\0info\x1f__scan__\n'
    emit_devices 1 devices Paired   # [scan] is row 0, so devices start at 1
}

emit_scan_menu() {
    printf '\0prompt\x1fbluetooth-scan\n'
    emit_devices 0 devices          # no [scan] row, devices start at 0
}

# Connect, echoing bluetoothctl's combined output so callers can inspect the
# failure reason (e.g. br-connection-key-missing).
try_connect() { bluetoothctl connect "$1" 2>&1; }

toggle() {
    mac="$1"
    if connected "$mac"; then
        bluetoothctl disconnect "$mac" >/dev/null 2>&1 \
            && notify "Disconnected" "$mac" || notify "Failed to disconnect" "$mac"
        return
    fi
    paired "$mac" || bluetoothctl pair "$mac" >/dev/null 2>&1
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true

    out=$(try_connect "$mac")
    if connected "$mac"; then
        notify "Connected" "$mac"
        return
    fi

    # br-connection-key-missing: the bond stored on this host is stale (the
    # device rotated its link key, typically after pairing to another host).
    # Retrying connect is futile — drop the bond and re-pair before retrying.
    # Scoped narrowly to this error so ordinary failures (device off / out of
    # range) keep the good bond intact and just report failure.
    case "$out" in
        *key-missing*)
            notify "Stale pairing — re-pairing" "$mac"
            bluetoothctl remove "$mac" >/dev/null 2>&1 || true
            bluetoothctl pair "$mac" >/dev/null 2>&1 || true
            bluetoothctl trust "$mac" >/dev/null 2>&1 || true
            try_connect "$mac" >/dev/null 2>&1 || true
            if connected "$mac"; then
                notify "Connected" "$mac"
            else
                notify "Re-pair failed" "Put $mac in pairing mode, then retry"
            fi
            ;;
        *)
            notify "Failed to connect" "$mac"
            ;;
    esac
}

if [ "$#" -gt 0 ] && [ -n "$1" ]; then
    info="${ROFI_INFO-}"
    case "$info" in
        __scan__)
            notify "Scanning for devices…"
            bluetoothctl --timeout 8 scan on >/dev/null 2>&1 || true
            emit_scan_menu
            exit 0
            ;;
    esac
    [ -n "$info" ] && toggle "$info"
    exit 0
fi

emit_menu
