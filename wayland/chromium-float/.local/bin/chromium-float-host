#!/usr/bin/env python3
"""Float chromium popup windows in sway.

Native-messaging host for the "Float popups (sway)" extension (source alongside
this script's config dir, ~/.config/chromium-float/extension).

The extension cannot tell us *which* window it just opened: a window.open popup
maps with app_id=chromium, indistinguishable from an ordinary browser window,
and no extension API reaches the Wayland app_id. So the correlation is done
here, by time. A background thread holds a sway `window` subscription and
records every newly mapped chromium container; when the extension pings (it
fires on chrome.windows.onCreated, a few ms *before* the surface maps) we take
the chromium window that appeared within MATCH_WINDOW of the ping.

Containers older than MATCH_WINDOW are discarded rather than floated — an
ordinary browser window opened seconds earlier must never get swept up. The
tradeoff is the reverse error: two windows mapping inside the same 2s bucket
can be matched to the wrong ping. That only misfires when a popup and a manual
new window land together, and the cost is a floated window, not a lost one.

Everything here is built for latency, because every millisecond between sway
mapping the window and us floating it is a frame in which the popup renders
tiled and the siblings reflow around it — a visible flash. Hence raw IPC
sockets rather than `swaymsg` subprocesses (measured 0.04ms vs 2.0ms per
command), and a condition variable rather than a poll loop, so a waiting
handler wakes the instant the window event lands instead of on the next tick.
"""

import glob
import json
import os
import socket
import struct
import sys
import threading
import time
from collections import deque

# Overridable only so the correlation can be exercised end-to-end against a
# throwaway app (e.g. `alacritty --class floattest`) without driving a browser.
APP_ID = os.environ.get("CHROMIUM_FLOAT_APP_ID", "chromium")

# How far either side of a ping a newly mapped window may sit and still be
# considered "the one". Generous enough to absorb a slow first paint, tight
# enough that a window opened by hand a moment earlier falls outside.
MATCH_WINDOW = 2.0

# Floating immediately beats the first frame but loses the size race: the
# client's initial buffer commit — already in flight at the size sway configured
# while tiling it — lands after our resize, and sway adopts it. So re-assert the
# size until it holds. Cheap: a tree query over the persistent socket is ~0.04ms.
SETTLE_TIMEOUT = 1.0
SETTLE_INTERVAL = 0.016
SETTLE_TOLERANCE = 4

MAGIC = b"i3-ipc"
MSG_RUN_COMMAND = 0
MSG_SUBSCRIBE = 2
MSG_GET_TREE = 4
EVENT_WINDOW = 0x80000003

# Chromium spawns us with stderr discarded, so there is nowhere for a traceback
# or a stray print to surface. Opt in by touching the flag file; both live in
# $XDG_RUNTIME_DIR so they vanish on logout and never land in the dotfiles repo
# (~/.config/chromium-float is a stow symlink into it).
_runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
DEBUG_FLAG = os.path.join(_runtime_dir, "chromium-float.debug")
DEBUG_LOG = os.path.join(_runtime_dir, "chromium-float.log")
_debug = os.path.exists(DEBUG_FLAG)

_recent = deque()      # (monotonic_ts, con_id) of newly mapped chromium windows
_floated = set()       # con_ids already claimed, so two pings can't share one
_cond = threading.Condition()
_send_lock = threading.Lock()
_command_ipc = None


def log(message):
    if not _debug:
        return
    try:
        with open(DEBUG_LOG, "a") as handle:
            handle.write("%.4f %s\n" % (time.monotonic(), message))
    except OSError:
        pass


def swaysock():
    """Locate a live sway IPC socket.

    The host inherits chromium's environment, which is whatever it was launched
    with — potentially a stale SWAYSOCK from a previous sway session, or none at
    all if chromium came up from a systemd user unit. Fall back to the newest
    socket for this uid.
    """
    sock = os.environ.get("SWAYSOCK")
    if sock and os.path.exists(sock):
        return sock
    socks = sorted(glob.glob("/run/user/%d/sway-ipc.*.sock" % os.getuid()))
    return socks[-1] if socks else None


class Ipc:
    """Minimal sway IPC client: 6-byte magic, u32 length, u32 type, payload."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(path)

    def send(self, msg_type, payload=b""):
        self.sock.sendall(MAGIC + struct.pack("=II", len(payload), msg_type) + payload)

    def recv(self):
        header = self._recv_exactly(14)
        length, msg_type = struct.unpack("=II", header[6:14])
        return msg_type, self._recv_exactly(length)

    def _recv_exactly(self, count):
        buf = b""
        while len(buf) < count:
            chunk = self.sock.recv(count - len(buf))
            if not chunk:
                raise ConnectionError("sway IPC closed")
            buf += chunk
        return buf


def watch(path):
    """Record every chromium window sway maps, waking any waiting handler."""
    try:
        ipc = Ipc(path)
        ipc.send(MSG_SUBSCRIBE, b'["window"]')
        ipc.recv()                      # subscription ack
        while True:
            msg_type, payload = ipc.recv()
            if msg_type != EVENT_WINDOW:
                continue
            try:
                event = json.loads(payload)
            except ValueError:
                continue
            if event.get("change") != "new":
                continue
            container = event.get("container") or {}
            if container.get("app_id") != APP_ID:
                continue
            con_id = container.get("id")
            if con_id is None:
                continue
            with _cond:
                _recent.append((time.monotonic(), con_id))
                _cond.notify_all()
    except (OSError, ConnectionError):
        return                          # sway went away; chromium will reap us


def take_match(ping):
    """Claim the chromium window belonging to a ping at time `ping`.

    Returns a con_id, or None if nothing mapped in time. Normally blocks, since
    the ping precedes the map — but wakes on the window event itself, so the
    tiled window exists for microseconds rather than until a poll tick.
    """
    deadline = ping + MATCH_WINDOW
    with _cond:
        while True:
            while _recent and _recent[0][0] < ping - MATCH_WINDOW:
                _recent.popleft()
            for index, (_, con_id) in enumerate(_recent):
                if con_id not in _floated:
                    del _recent[index]
                    _floated.add(con_id)
                    if len(_floated) > 512:     # long sessions; ids never repeat
                        _floated.clear()
                    return con_id
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            _cond.wait(remaining)


def float_window(con_id, width, height):
    """Float, size and centre in a single atomic sway command.

    The size comes from chromium, not from sway. Because we float ~1.5ms after
    the map, sway's `natural` geometry for the view is still the size it
    configured the window to while tiling it — chromium commits its preferred
    geometry a frame or two later. Asking sway to float on its own numbers
    therefore reproduces the *tiled* dimensions and centres against them,
    leaving the popup oversized and off-centre once chromium finally resizes.
    (Floating the same popup by hand seconds later does pick up the requested
    size — which is why this only shows up once the host is fast.)

    One command, not three: sway applies a comma-chained list as one
    transaction, so the window never renders at an intermediate size.

    Chromium reports DIP. eDP-1 runs at scale 1.0, so these are sway logical
    pixels 1:1; on a scaled output they would need dividing by the output scale.
    """
    parts = ["[con_id=%d] floating enable" % con_id]
    if width and height:
        parts.append("resize set width %d px height %d px" % (width, height))
    parts.append("move position center")
    command = ", ".join(parts).encode()
    log("command: %s" % command.decode())
    with _send_lock:
        try:
            _command_ipc.send(MSG_RUN_COMMAND, command)
            _command_ipc.recv()
        except (OSError, ConnectionError):
            pass


def container_rect(con_id):
    """Current rect of one container, or None if it's gone."""
    with _send_lock:
        try:
            _command_ipc.send(MSG_GET_TREE)
            _, payload = _command_ipc.recv()
        except (OSError, ConnectionError):
            return None
    try:
        stack = [json.loads(payload)]
    except ValueError:
        return None
    while stack:
        node = stack.pop()
        if node.get("id") == con_id:
            return node.get("rect")
        stack.extend(node.get("nodes", []))
        stack.extend(node.get("floating_nodes", []))
    return None


def settle(con_id, width, height):
    """Hold the requested size against the client's late initial commit.

    Measured on a popup asking for 500x600: the float+resize+centre lands
    correctly (the window is positioned at the exact centre for 500x600), then
    the client's first buffer — sized to the tiling layout, and already queued
    before we floated — arrives and sway takes that as the floating size. The
    result is a correctly *placed* but wrongly *sized* window.

    Deliberately no early exit on "looks right now". The first version stopped
    after two consecutive good samples, which it reached ~32ms in, before the
    client had drawn at all; the late commit then landed with nobody watching
    and the window stayed wrong. Clients take a wildly variable time to produce
    that first buffer, so watch the whole window instead and re-assert on any
    drift. A tree query is ~0.04ms, so ~60 of them is free.

    The cost is that a manual resize within SETTLE_TIMEOUT gets stomped. That
    needs the user to grab a popup within a second of it appearing.
    """
    deadline = time.monotonic() + SETTLE_TIMEOUT
    while time.monotonic() < deadline:
        time.sleep(SETTLE_INTERVAL)
        rect = container_rect(con_id)
        if rect is None:
            return                      # window closed under us
        if (abs(rect.get("width", 0) - width) > SETTLE_TOLERANCE
                or abs(rect.get("height", 0) - height) > SETTLE_TOLERANCE):
            log("drift: rect=%sx%s want=%sx%s -> re-assert"
                % (rect.get("width"), rect.get("height"), width, height))
            float_window(con_id, width, height)


def valid_dimension(value):
    return isinstance(value, int) and 0 < value < 10000


def handle(ping, width, height):
    con_id = take_match(ping)
    log("matched con_id=%s for ping (want %sx%s)" % (con_id, width, height))
    if con_id is None:
        return
    float_window(con_id, width, height)
    if width and height:
        settle(con_id, width, height)


def read_message():
    """Read one native-messaging frame: 4-byte LE length, then JSON."""
    header = sys.stdin.buffer.read(4)
    if len(header) != 4:
        return None
    (length,) = struct.unpack("<I", header)
    body = sys.stdin.buffer.read(length)
    if len(body) != length:
        return None
    try:
        return json.loads(body)
    except ValueError:
        return None


def main():
    global _command_ipc
    path = swaysock()
    if path is None:
        return
    try:
        _command_ipc = Ipc(path)
    except OSError:
        return
    log("host started, sock=%s app_id=%s" % (path, APP_ID))
    threading.Thread(target=watch, args=(path,), daemon=True).start()
    while True:
        message = read_message()
        if message is None:
            break              # port closed: chromium exited, or MV3 reclaimed the worker
        log("ping: %r" % (message,))
        if not isinstance(message, dict) or message.get("action") != "float":
            continue
        width = message.get("width")
        height = message.get("height")
        if not (valid_dimension(width) and valid_dimension(height)):
            log("dimensions rejected (%r, %r) -> sway sizing" % (width, height))
            width = height = None      # fall back to sway's own sizing
        # Off-thread so a ping arriving during another ping's wait isn't queued
        # behind it — two popups can open back to back.
        threading.Thread(target=handle, args=(time.monotonic(), width, height),
                         daemon=True).start()


if __name__ == "__main__":
    main()
