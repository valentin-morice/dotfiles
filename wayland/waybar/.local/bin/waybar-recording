#!/usr/bin/env bash
# waybar custom/recording module — prints a record icon (frozen red) while
# wf-recorder is running, and nothing otherwise (empty output → waybar hides the
# module, so it adds no gap when idle). Refreshed on demand by screenrecord,
# which sends `pkill -RTMIN+8 waybar` on start and stop.
#
# The red lives in style.css on the "recording" class. Kept red deliberately:
# like battery-critical this is an alarm state, not part of the icons' ordinary
# foreground colour.
#
# Emits waybar JSON (return-type json) so the module carries a tooltip alongside
# the icon. The tooltip is an action hint, not a live duration: this module only
# re-runs on the RTMIN+8 signal (interval: once), so a ticking timer would freeze
# at its start value — a "click to stop" hint is the honest affordance instead.
# Glyph is a UTF-8 octal escape (pure-ASCII source, unmanglable), matching the
# convention in waybar-powerprofile.
icon=$(printf '\363\260\273\202')  # U+F0EC2 md-record_circle

if pgrep -x wf-recorder >/dev/null 2>&1; then
    printf '{"text":"<span size=\\"177%%\\">%s</span>","tooltip":"Screen recording in progress — click to stop","class":"recording"}\n' \
        "$icon"
else
    printf '{"text":""}\n'
fi
