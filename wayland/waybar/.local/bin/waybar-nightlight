#!/usr/bin/env bash
# waybar custom/nightlight module — reminds you when gammastep's colour-temp
# shift has been turned OFF (the flag file nightlight-toggle sets); prints
# nothing while night-light is in its normal enabled state (empty → module
# hidden). Refreshed by nightlight-toggle, which sends `pkill -RTMIN+10 waybar`.
# Emits waybar JSON (return-type json) so the label carries a "click to re-enable"
# tooltip; empty text otherwise so waybar hides the module.
# shellcheck disable=SC1091
. "$HOME/.config/theme/load.sh" 2>/dev/null || THEME_muted_fixed="#808488"
THEME_muted_fixed="${THEME_muted_fixed:-#808488}"

flag="${XDG_RUNTIME_DIR:-/tmp}/nightlight.off"
if [ -e "$flag" ]; then
    printf '{"text":"<span foreground=\\"%s\\">NIGHT OFF</span>","tooltip":"Night light disabled — click to re-enable","class":"nightlight"}\n' \
        "$THEME_muted_fixed"
else
    printf '{"text":""}\n'
fi
