#!/usr/bin/env bash
# waybar custom/nightlight module — reminds you when gammastep's colour-temp
# shift has been turned OFF (the flag file nightlight-toggle sets); prints
# nothing while night-light is in its normal enabled state (empty → module
# hidden). Refreshed by nightlight-toggle, which sends `pkill -RTMIN+10 waybar`.
# Emits waybar JSON (return-type json) so the icon carries a "click to re-enable"
# tooltip; empty text otherwise so waybar hides the module.
#
# No colour and no palette sourcing: style.css colours the "nightlight" class,
# so a theme switch needs no module re-exec.

# Glyph is a UTF-8 octal escape (pure-ASCII source, unmanglable), matching the
# convention in waybar-powerprofile. Plain moon (not a "disabled" variant — none
# exists in this font) reads as "night mode" here; the muted colour plus this
# module only ever appearing while OFF is what signals the state, same as the
# other signal-driven modules.
icon=$(printf '\363\260\226\224')  # U+F0594 md-weather_night

flag="${XDG_RUNTIME_DIR:-/tmp}/nightlight.off"
if [ -e "$flag" ]; then
    printf '{"text":"<span size=\\"159%%\\">%s</span>","tooltip":"Night light disabled — click to re-enable","class":"nightlight"}\n' \
        "$icon"
else
    printf '{"text":""}\n'
fi
