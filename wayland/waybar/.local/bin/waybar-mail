#!/usr/bin/env bash
# waybar custom/mail module. Reads the state file imap-daemon writes (line 1 =
# unread count, line 2 = subject) and emits waybar JSON. The IMAP backend is
# display-agnostic — it just writes a file, this just reads it.
#
# No colour is emitted: style.css colours #custom-mail (and its .stale state),
# so the JSON is theme-independent and a theme switch needs no module re-exec.
set -u

# Prefer the daemon's new per-user runtime path; fall back to the legacy /tmp
# path so this keeps working with a not-yet-rebuilt daemon (and auto-upgrades
# once the rebuilt daemon starts writing the runtime-dir file).
state="${XDG_RUNTIME_DIR:-/tmp}/imap.txt"
[ -e "$state" ] || state="/tmp/imap-$USER.txt"

stale_after=5400   # seconds; > 2x the daemon's 25-min IDLE ceiling

# Glyph is a UTF-8 octal escape (pure-ASCII source, unmanglable), matching the
# convention in waybar-powerprofile. It is a Material Symbols Private Use Area
# codepoint,
# emitted bare: style.css gives this module its font and size.
icon=$(printf '\356\205\231')  # U+E159 mail

# The tooltip is rendered as pango markup, so &, <, > must be entity-escaped
# BEFORE the JSON \ and " escaping — otherwise a subject like `A & B <x>` yields
# invalid markup and a broken/empty tooltip.
esc() {
    printf '%s' "$1" \
        | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/\\/\\\\/g; s/"/\\"/g'
}

# $1 = tooltip body, $2 = class. The bar is icon-only, so the unread count is
# deliberately NOT printed: the icon appearing at all already means "unread".
# The count and the subject live in the tooltip instead, prefixed "Mail: " to
# match the other module tooltips ("Bluetooth: Off", "Power profile: Balanced").
emit() {
    printf '{"text":"%s","tooltip":"Mail: %s","class":"%s"}\n' \
        "$icon" "$1" "$2"
}

c=$(awk 'NR==1' "$state" 2>/dev/null)
subj=$(awk 'NR==2' "$state" 2>/dev/null)

# Surface a dead/stalled daemon instead of showing a frozen count forever: if the
# file is missing or hasn't been touched in stale_after seconds, mark it stale.
now=$(date +%s)
mtime=$(stat -c %Y "$state" 2>/dev/null || echo 0)

if [ ! -e "$state" ]; then
    # No state file at all: the daemon never ran (or was deliberately never
    # enabled) — stay blank rather than nag with a permanent "?" badge.
    printf '{"text":"","class":"read"}\n'
elif [ "$((now - mtime))" -gt "$stale_after" ]; then
    emit "daemon not updating" "stale"
elif [ "$c" = "?" ]; then
    emit "check failed" "stale"
elif [ -z "$c" ] || [ "$c" = "0" ]; then
    printf '{"text":"","class":"read"}\n'
else
    emit "$c unread — $(esc "$subj")" "unread"
fi
