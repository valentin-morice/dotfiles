# kanshi — per-profile output layouts (applied automatically on hotplug).
# A profile matches only when its output list is exactly the set of connected
# displays, so `laptop` and `docked` never both apply.
#
# Both profiles exec wallpaper-apply: awww only paints outputs that existed when
# `awww img` last ran, so a display that appears later comes up solid black until
# it is re-run.

profile laptop {
    output eDP-1 enable mode 1920x1200@60Hz position 0,0
    exec ~/.local/bin/wallpaper-apply
    # Undocking strands the external's workspaces (5-8) on the laptop, where any
    # that still hold a window show up as extra buttons past the fixed four.
    # Fold them into 4. Only reached from this profile, i.e. only when the
    # external is genuinely gone.
    exec ~/.local/bin/undock-workspaces
}

# Lenovo L24i-4A over USB-C/DP. Matched by make/model/serial rather than the
# connector name: DP-6 is whatever the dock happened to enumerate this boot and
# changes between ports/reboots.
#
# Stacked, not side-by-side: the external sits on top (0,0) and the laptop panel
# directly below it at y=1080 (= the external's height). Both are 1920 wide, so
# x=0 on both lines their edges up exactly and the pointer crosses straight
# through. The laptop keeps 1920x1200, hence the desktop is 1920x2280 tall.
profile docked {
    output "Lenovo Group Limited L24i-4A URHNYW8T" enable mode 1920x1080@60Hz position 0,0
    output eDP-1 enable mode 1920x1200@60Hz position 0,1080
    exec ~/.local/bin/wallpaper-apply
}
