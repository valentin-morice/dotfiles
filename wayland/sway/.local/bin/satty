#!/bin/sh
# satty wrapper — locally "hijack" the toolbar icons without rebuilding satty.
#
# satty embeds its icons (Fluent, via relm4-icons) in a gresource compiled into
# the binary, so the system icon theme has no effect. The toolbar mixes styles:
# a few buttons ship the -filled- Fluent variant, and two (trash, line) come from
# a different set entirely (GNOME icon-development-kit). GLib's G_RESOURCE_OVERLAYS
# remaps those resource paths to local Fluent -regular- SVGs at runtime, so the
# whole toolbar becomes one outline set.
#
# The override SVGs are pulled from the same source satty builds from
# (github.com/Relm4/icons, fluentui-system-icons), living in
# ~/.local/share/satty/icon-overrides/. Drop a replacement SVG there and add a
# line below to reskin any other button too. Deliberately NOT overridden:
# paint-bucket-filled — satty embeds both paint-bucket variants as the fill
# toggle's on/off states, so the filled/outline distinction is meaningful there.
ov="$HOME/.local/share/satty/icon-overrides"
# Exact embedded layout (extracted from the binary's gresource): the icons live
# under a GTK icon-theme subtree, not flat at the prefix.
base="/com/gabm/satty/icons/scalable/actions"

G_RESOURCE_OVERLAYS="\
$base/arrow-undo-filled-symbolic.svg=$ov/arrow-undo-regular-symbolic.svg:\
$base/arrow-redo-filled-symbolic.svg=$ov/arrow-redo-regular-symbolic.svg:\
$base/arrow-up-right-filled-symbolic.svg=$ov/arrow-up-right-regular-symbolic.svg:\
$base/crop-filled-symbolic.svg=$ov/crop-regular-symbolic.svg:\
$base/recycling-bin-symbolic.svg=$ov/delete-regular-symbolic.svg:\
$base/minus-large-symbolic.svg=$ov/line-horizontal-1-regular-symbolic.svg:\
$base/pen-regular-symbolic.svg=$ov/edit-regular-symbolic.svg"
export G_RESOURCE_OVERLAYS

exec /usr/sbin/satty "$@"
