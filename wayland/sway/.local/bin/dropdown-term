#!/bin/sh
# Toggle the drop-down scratchpad terminal, respawning it first if it was ever
# closed (Ctrl-D / crash) so $mod+grave never becomes a dead key. The sway
# config's `for_window [app_id="dropdown-term"] … move scratchpad` rule floats
# and stashes any fresh instance, so a new spawn lands in the scratchpad and the
# `scratchpad show` below reveals it.
set -eu

exists() {
    swaymsg -t get_tree \
        | jq -e '[.. | select(.app_id? == "dropdown-term")] | length > 0' >/dev/null 2>&1
}

# True once the window exists AND the `for_window … move scratchpad` rule has
# actually stashed it (scratchpad_state leaves "none" the moment it's moved).
# Waiting on this rather than mere existence closes the race where `scratchpad
# show` raced ahead of the stash and the first $mod+grave after a respawn no-op'd.
stashed() {
    swaymsg -t get_tree | jq -e \
        '[.. | select(.app_id? == "dropdown-term" and (.scratchpad_state // "none") != "none")] | length > 0' \
        >/dev/null 2>&1
}

if ! exists; then
    alacritty --class dropdown-term >/dev/null 2>&1 &
    # Poll until it's mapped and stashed (up to ~2s) instead of a fixed sleep.
    i=0
    while ! stashed; do
        i=$((i + 1)); [ "$i" -ge 100 ] && break; sleep 0.02
    done
fi

exec swaymsg '[app_id="dropdown-term"] scratchpad show, move position center'
