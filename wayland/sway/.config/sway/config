# sway config — ported from the i3 config (i3wm.org syntax is shared).
# Differences from i3 are Wayland-specific: input/output/seat blocks replace
# xrandr/unclutter, the bar is waybar, lock/idle is swaylock+swayidle, and the
# X-only autostarts (snixembed/picom/xsettingsd/xset/redshift) are gone.
# See sway(5) for the full reference.

set $mod Mod4

# Font for window titles / fallbacks.
font pango:JetBrainsMono Nerd Font 10

### Session environment ------------------------------------------------------
# Push the Wayland session env into the systemd user + dbus activation
# environment, THEN bring up graphical-session.target via sway-session.target.
# Ordering matters (hence one chained exec): the env must be in place before the
# target starts, or xdg-desktop-portal fails to activate ("dependency failed"),
# which breaks live GTK3/Qt theme switching, screen-share, and the SNI tray.
# XDG_CURRENT_DESKTOP (sway:wlroots, set from sway.desktop) is the portal's
# backend selector and is load-bearing for live GTK3/Qt recolour.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE SWAYSOCK && \
     dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && \
     systemctl --user start sway-session.target

### Input / output / seat ----------------------------------------------------
# libinput replaces the X input config. Tap-to-click + disable-while-typing on
# the touchpad; explicit us layout (X used the default).
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
}
input "type:keyboard" {
    xkb_layout us
    # Euro sign (€) on AltGr+5 — the € printed on the 5 key. eurosign:5 places it
    # at level 3 of that key; lv3:ralt_switch makes Right Alt the level-3 (AltGr)
    # selector, which the base "us" layout otherwise lacks. Trade-off: Right Alt
    # stops acting as a plain Alt (Left Alt is unaffected).
    xkb_options eurosign:5,lv3:ralt_switch
    # sway's default 600ms/25Hz is sluggish for terminal/vim work.
    repeat_delay 250
    repeat_rate 35
}

# Output left at scale 1.0 (the bar and UI are sized right there). The only
# thing that was too small was alacritty, whose tiny 6.5pt was leaning on X11's
# high panel DPI — fixed by bumping its own font size instead of scaling the
# whole desktop. Add `output <name> { ... }` here only if a display needs a
# mode/scale/position.

# Wallpaper: awww-daemon (a swww fork) owns the background (started in Autostart
# below); theme-render sets the per-theme image with a cross-fade. swaybg can't
# fade (draws once and exits, flashing black on swap), so awww replaces it.

# Hide the pointer after 3s idle (replaces unclutter --timeout 3).
seat * hide_cursor 3000

# Pin the cursor theme so the compositor pointer (over the wallpaper, during
# drags/resizes) and XWayland apps match GTK's Adwaita instead of falling back
# to the default. sway also exports XCURSOR_THEME/XCURSOR_SIZE from this.
seat * xcursor_theme Adwaita 24

### Autostart ----------------------------------------------------------------
# XDG autostart .desktop files (1Password, Ferdium, etc.).
exec dex --autostart --environment sway

# Wallpaper daemon — owns the background and cross-fades between images. Started
# once (exec, not exec_always, so it survives reloads); theme-render sets the
# actual image once the daemon is up.
exec awww-daemon

# Wallpaper image + per-tool colors for the active theme (renders configs and
# fades to the wallpaper via awww without reloading sway, so it's safe inside
# exec_always).
exec_always ~/.local/bin/theme-render --no-reload

# Status bar.
exec_always ~/.config/waybar/launch.sh

# Notifications.
exec dunst

# Clipboard-copy notifications + history capture (wl-clipboard).
exec ~/.local/bin/clip-notify

# Night-time colour temperature (Wayland; replaces redshift).
exec gammastep

# MPRIS proxy: routes media keys / playerctl to the most-recently-active player
# (see the XF86Audio binds). Started once; harmless if already running.
exec playerctld daemon

# Polkit authentication agent (GUI auth prompts for gparted, etc.).
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# No network/bluetooth tray agent is started here — nm-applet and blueman are
# uninstalled, and the two TUIs on $mod+n / $mod+b carry the agents themselves:
# nmtui embeds NetworkManager's secret agent (NMSecretAgentSimple — the Wi-Fi
# passphrase prompt) and bluetui registers an org.bluez.Agent1 for the duration
# of its run (the PIN/confirm prompt). The consequence of no *resident* agent:
# a secret or pairing request raised while neither TUI is open goes unanswered
# rather than popping a dialog — open the relevant TUI and retry.
#
# The tray stays in waybar for real graphical apps that speak SNI; it just no
# longer carries wifi/BT, which are waybar modules again (see waybar's config).

# Thunar daemon (needed for thunar-volman to auto-mount removable media) is NOT
# started here: an `exec` races xdg-desktop-portal and the daemon loses its theme
# for the whole session. It's a systemd unit ordered after the portal instead —
# see common/systemd/.config/systemd/user/thunar.service.d/theme-ordering.conf.
# sway-session.target (started above) pulls it in.

# Lock + idle: swayidle owns idle-dim/lock, before-sleep lock, and the logind
# lock signal (so loginctl lock-session / $mod+Shift+x route through it too).
exec_always ~/.config/sway/idle.sh

# Inhibit idle while any audio stream plays (restores xidlehook's
# --not-when-audio; covers podcasts/music without a fullscreen window).
exec sway-audio-idle-inhibit

# Output profile switcher (per-profile layouts once an external display
# exists; see ~/.config/kanshi/config).
exec kanshi

# Lid-switch handling — ONLY enable once a dock/external display exists (fill in
# the kanshi `docked` profile too). Left commented on purpose: with no external
# output, closing the lid should suspend (logind's default) rather than just
# blanking eDP-1, so activating this undocked would fight logind.
#   bindswitch --locked --reload lid:on  output eDP-1 disable
#   bindswitch --locked --reload lid:off output eDP-1 enable

### Theme toggle -------------------------------------------------------------
bindsym $mod+Shift+t exec ~/.local/bin/theme-switch toggle

### Notifications & utilities ------------------------------------------------
# Do-Not-Disturb toggle (pauses dunst); the RTMIN+9 signal refreshes the DND bar
# module immediately instead of waiting for its poll.
bindsym $mod+Shift+d exec ~/.local/bin/dnd-toggle
# Dismiss all visible notifications; pop the most recent one back from history.
bindsym $mod+Shift+BackSpace exec dunstctl close-all
bindsym $mod+Shift+grave exec dunstctl history-pop
# Night-light (gammastep) toggle + emoji picker.
bindsym $mod+Shift+g exec ~/.local/bin/nightlight-toggle
bindsym $mod+period exec ~/.local/bin/emoji-picker

### Hardware keys ------------------------------------------------------------
# --locked so these keep working on the lock screen (swaylock holds the seat;
# a plain bind is swallowed). Restores i3lock's --pass-media-keys/--pass-volume-keys.
# Volume
bindsym --locked XF86AudioRaiseVolume exec ~/.local/bin/volume-notify up
bindsym --locked XF86AudioLowerVolume exec ~/.local/bin/volume-notify down
bindsym --locked XF86AudioMute exec ~/.local/bin/volume-notify mute
bindsym --locked XF86AudioMicMute exec ~/.local/bin/toggle-mic-mute

# Brightness
bindsym --locked XF86MonBrightnessUp exec ~/.local/bin/brightness-notify up
bindsym --locked XF86MonBrightnessDown exec ~/.local/bin/brightness-notify down

# Media keys — routed through playerctld (started in Autostart) so the key hits
# the most-recently-active player (Spotify vs a browser tab), not whichever
# registered on MPRIS first.
bindsym --locked XF86AudioPlay exec playerctl --player=playerctld play-pause
bindsym --locked XF86AudioNext exec playerctl --player=playerctld next
bindsym --locked XF86AudioPrev exec playerctl --player=playerctld previous
# Convenience alias for the mic toggle (some keyboards lack XF86AudioMicMute).
bindsym $mod+m exec ~/.local/bin/toggle-mic-mute

### Window management --------------------------------------------------------
# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
# (sway's tiling_drag takes one arg, unlike i3's `modifier titlebar`; `enable`
# gives both titlebar-drag and floating-modifier-drag.)
tiling_drag enable

# Touchpad gestures — 3-finger horizontal swipe cycles workspaces (the sway
# laptop feature X11/i3 never had).
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

# start a terminal
bindsym $mod+Return exec alacritty

# Browser (chromium) and file manager (thunar). Chromium runs behind wl-relabel,
# which rewrites the app_id of popups and DevTools before those windows map so
# the for_window rules further down can float them without a tiled flash. The
# desktop file is wrapped the same way, because chromium is single-instance: a
# launch that bypasses the proxy attaches to the running browser and silently
# gets no rewriting.
bindsym $mod+Shift+Return exec wl-relabel -- chromium
bindsym $mod+Shift+f exec thunar

# Editor (vscodium)
bindsym $mod+Shift+v exec codium

# kill focused window
bindsym $mod+Shift+q kill

# Application launcher (rofi's native drun mode; -show-icons adds app icons,
# kept off for the dmenu wrappers. The "drun ❯" prompt comes from display-drun
# in config.rasi — drun mode ignores -p.)
bindsym $mod+d exec rofi -show drun -show-icons

# Clipboard history (entries recorded by clip-notify)
bindsym $mod+c exec ~/.local/bin/rofi-clip

# Window switcher and CPU power-profile picker. rofi could fold these into one
# mode-switcher, but each is kept as its own bind + -dmenu wrapper in
# ~/.local/bin (a faithful 1:1 of the old fuzzel binds). $mod+w (was "layout
# tabbed") is the switcher's mnemonic home.
bindsym $mod+w exec ~/.local/bin/rofi-window
bindsym $mod+p exec ~/.local/bin/rofi-profile

# Wi-Fi (nmtui) and Bluetooth (bluetui) in a floating terminal — floated by the
# for_window rules below. `--class` (not --app-id, which alacritty has no flag
# for) sets the Wayland app_id those rules match on. The waybar network/
# bluetooth modules run these same two commands on click.
bindsym $mod+n exec alacritty --class netmenu-float -e nmtui
bindsym $mod+b exec alacritty --class btmenu-float -e bluetui

# Power menu (lock / logout / suspend / reboot / shutdown)
bindsym $mod+Escape exec ~/.local/bin/rofi-power

# Keybinding cheat sheet — toggles a floating terminal listing every bind
# (the helper kills its own window on a second press; see the for_window rule
# below and ~/.local/bin/keybind-help). $mod+Shift+slash is "$mod+?" on the us
# layout, the conventional help mnemonic.
bindsym $mod+Shift+slash exec ~/.local/bin/keybind-help

# Float + centre the network/bluetooth TUI terminals so they read like pop-up
# menus rather than tiling into the layout. Alacritty is Wayland-native, so the
# app_id set by --class matches directly (no XWayland class fallback needed).
for_window [app_id="netmenu-float"] floating enable, resize set width 900 px height 600 px, move position center
for_window [app_id="btmenu-float"] floating enable, resize set width 900 px height 600 px, move position center

# Keybinding cheat sheet ($mod+?) — float + centre it like the pop-up menus,
# sized to fit the two-column sheet without scrolling.
for_window [app_id="keybind-help"] floating enable, resize set width 1000 px height 820 px, move position center

# Keep the screen awake for fullscreen video (movies). Browsers only request
# the Wayland idle-inhibit protocol unreliably, so pin it to fullscreen state
# instead: no dim at 9min / lock at 10min (see idle.sh) while a browser window
# is fullscreen. Covers both Wayland-native (app_id) and XWayland (class).
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [app_id="chromium"] inhibit_idle fullscreen
for_window [class="firefox"] inhibit_idle fullscreen
for_window [class="Chromium"] inhibit_idle fullscreen

# Picture-in-Picture: float it and make it sticky so a video pop-out follows you
# across workspaces instead of tiling into the layout. Covers Wayland-native
# (app_id) and XWayland (class); Chromium/Firefox title the window differently.
#
# Chromium's Wayland PiP window is the odd one out: it maps with an EMPTY app_id, not
# "chromium", so no [app_id="chromium" title=...] rule could ever match it — measured
# with `wl-relabel --log`, which reports app_id "" and title "Picture in picture".
# wl-relabel gives it the identity below; see ~/.config/wl-relabel/rules.toml.
for_window [app_id="firefox" title="Picture-in-Picture"] floating enable, sticky enable
for_window [class="firefox" title="Picture-in-Picture"] floating enable, sticky enable
for_window [app_id="chromium-pip"] floating enable, sticky enable
for_window [class="Chromium" title="^Picture[- ]in[- ]picture"] floating enable, sticky enable

# Float transient XWayland windows — dialogs, pop-ups, splash screens — so they
# pop over the layout instead of tiling in. window_type/window_role are X11-only
# criteria, so these match ONLY XWayland windows (1Password, GIMP/Java dialogs,
# etc.) and never touch the Wayland-native majority (which has no such property).
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="splash"] floating enable

# Mark XWayland (X11) clients in tabbed/stacked titlebars, so it's obvious at a
# glance which windows aren't running natively on Wayland.
for_window [shell="xwayland"] title_format "[X] %title"

# GNOME polkit auth prompt (the password dialog for gparted etc.). Runs
# Wayland-native here, so it's matched by app_id (window_type wouldn't apply).
for_window [app_id="polkit-gnome-authentication-agent-1"] floating enable, move position center

# Portal-rendered GTK dialogs — the file chooser (Open/Save) and the system
# print dialog, used by browsers, Electron apps, and Flatpaks — tile by default.
# Float + centre them. The app_id is stable and locale-independent, so no fragile
# title matching is needed. (Chromium routes both here: its Ctrl+P preview is
# tab-modal, and "Print using system dialog…" arrives as portal window "&Print…".)
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, move position center

# Chromium's own auxiliary windows. Unlike the portal dialog above, these are
# real xdg-shell toplevels sharing app_id=chromium with ordinary browser
# windows, so only the title separates them — and chromium suffixes the task
# manager's title with " - Chromium" exactly like a page title (the string is
# literally "Task Manager - Chromium" in locales/en-US.pak). So a browser window
# whose active tab is titled "Task Manager" collides with this rule and floats
# too; there is no anchor that separates them. Rare enough to accept. Titles are
# English here (LANG=en_US.UTF-8).
#
# Note there is no default Linux keybinding for the task manager — Shift+Esc is
# Windows/ChromeOS only. It opens from ⋮ → More tools → Task manager.
for_window [app_id="chromium" title="^Task Manager - Chromium$"] floating enable, resize set width 900 px height 600 px, move position center

# Undocked DevTools. The title carries the inspected URL, so a page genuinely
# titled "DevTools - …" would float too. Rare enough to accept.
for_window [app_id="chromium" title="^DevTools - "] floating enable, resize set width 1200 px height 800 px, move position center

# Popups (OAuth consent, SSO hand-off, payment flows) and undocked DevTools,
# matched on the identity wl-relabel assigns before the window maps rather than
# on a title. See ~/Projects/wl-relabel. A window.open child is indistinguishable
# from an ordinary browser window over xdg-shell — same app_id, page-derived
# title — so the proxy identifies it by the two signals it does emit: it asks the
# compositor to draw its frame, and its minimum width is far below a main
# window's. Floating lands on the first frame, so there is no tiled flash to
# correct.
#
# The DevTools rule above is kept deliberately as a fallback: it stops matching
# once the identity changes, but it still fires for a chromium started outside
# the proxy.
for_window [app_id="chromium-devtools"] floating enable, resize set width 1200 px height 800 px, move position center
for_window [app_id="chromium-popup"] floating enable
for_window [app_id="firefox-popup"] floating enable

# Firefox needs no size or title fallback the way chromium does above: it reports
# min_size (95, 95) for a window.open popup against (500, 120) for a main window,
# measured on firefox 153.0, so the same two-signal rule catches it. There is no
# pre-proxy rule to keep here, because there was never a way to write one.

# The task manager. Measured: chromium gives it an EMPTY app_id, so the
# ^Task Manager - Chromium$ rule above has never been able to match it — that is
# chromium's own behaviour and has nothing to do with the proxy. Unlike the
# DevTools rule it is not a fallback, it is dead. wl-relabel gives it a real
# identity, which also removes the ambiguity that rule's comment describes: a
# browser window whose tab is titled "Task Manager" keeps app_id=chromium and so
# no longer collides.
for_window [app_id="chromium-taskmanager"] floating enable, resize set width 900 px height 600 px, move position center

# Screenshots (grim + slurp)
bindsym Print exec ~/.local/bin/screenshot region
bindsym Shift+Print exec ~/.local/bin/screenshot full
bindsym Ctrl+Print exec ~/.local/bin/screenshot output
bindsym $mod+Shift+Print exec ~/.local/bin/screenshot window

# Screen recording toggle (wf-recorder; region via slurp)
bindsym $mod+Print exec ~/.local/bin/screenrecord

# Lock now (routes through logind -> swayidle's lock handler, themed)
bindsym $mod+Shift+x exec loginctl lock-session

# change focus — true vim hjkl (h=left, j=down, k=up, l=right). This displaces
# "split h" off $mod+h; it now lives on $mod+semicolon (see below).
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window — hjkl to match the focus cluster above.
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation. Moved off $mod+h (now "focus left" in the vim
# hjkl cluster) to $mod+semicolon — the key that move freed up. It sits just right
# of l, so the split pair ($mod+semicolon / $mod+v) stays next to the focus keys.
bindsym $mod+semicolon split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout. $mod+e cycles split -> tabbed -> stacking (the
# orientation of a split is set explicitly with $mod+semicolon / $mod+v); $mod+s jumps
# straight to stacking. ($mod+w used to be "layout tabbed" but is now the rofi
# window switcher — hence cycling tabbed onto $mod+e so it stays reachable.)
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split tabbed stacking

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

### Scratchpad ----------------------------------------------------------------
# Stash the focused window / cycle stashed windows back.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Drop-down terminal: pre-spawned into the scratchpad, toggled with $mod+grave.
# The bind goes through a helper that respawns the terminal if it was ever
# closed (Ctrl-D / crash), so $mod+grave never turns into a dead key.
exec alacritty --class dropdown-term
for_window [app_id="dropdown-term"] floating enable, resize set width 1600 px height 700 px, move scratchpad
bindsym $mod+grave exec ~/.local/bin/dropdown-term

### Workspaces ---------------------------------------------------------------
# Capped at 4 workspaces so the waybar row is a fixed width and never layout-
# shifts (waybar renders 1–4 persistently; see persistent-workspaces there). To
# go back to 10, restore $ws5–$ws10 and the 5–0 binds below.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

# Bounce between the two most recent workspaces; pressing the current
# workspace's own $mod+N does the same (auto_back_and_forth).
bindsym $mod+Tab workspace back_and_forth
workspace_auto_back_and_forth yes

### Session control ----------------------------------------------------------
# reload the configuration file
bindsym $mod+Shift+c reload
# sway has no i3-style `restart`; reload is the only in-place refresh, so this
# is a muscle-memory alias for $mod+Shift+c.
bindsym $mod+Shift+r reload
# exit sway (ends the Wayland session) — rofi-confirm floats over content;
# the old swaynag bar reserved an exclusive zone and resized the tiling
bindsym $mod+Shift+e exec ~/.local/bin/rofi-confirm 'Exit sway' 'swaymsg exit' logout 'End the Wayland session?'

### Resize -------------------------------------------------------------------
mode "resize" {
        # hjkl, matching the focus cluster: h/l shrink/grow width, j/k grow/shrink height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Gaps mode ----------------------------------------------------------------
# Adjust inner gaps live: +/- to grow/shrink, 0 to reset, Esc/Return to exit.
mode "gaps" {
        bindsym plus  gaps inner all plus 5
        bindsym equal gaps inner all plus 5
        bindsym minus gaps inner all minus 5
        bindsym 0     gaps inner all set 10
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+g mode "default"
}
bindsym $mod+g mode "gaps"

### Gaps / borders -----------------------------------------------------------
gaps inner 10
gaps outer 0
smart_gaps on
smart_borders on

default_border pixel 2
default_floating_border pixel 2

# class colours (focused/unfocused/urgent…) — rendered per-theme by theme-render.
include ~/.config/sway/colors.conf
