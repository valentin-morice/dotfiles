# Secret — kept on disk for runtime (read via the imap symlink), never committed
common/imap/.config/imap/imap.env
# Compiled Go helper (built to ~/.local/bin/imap-daemon, not tracked)
common/imap/.config/imap/imap

# Generated by theme-render from the active theme palette; never tracked. These
# live inside the repo tree because their packages are stow-folded into it.
wayland/sway/.config/sway/colors.conf
wayland/waybar/.config/waybar/config
wayland/waybar/.config/waybar/style.css
common/alacritty/.config/alacritty/colors.toml
common/git/.config/git/delta-theme.gitconfig
common/nvim/.config/nvim/lua/theme/palette.lua

# Launch-time style overlay written by waybar/launch.sh (@imports style.css);
# waybar watches it for flicker-free live recolour on theme switch.
wayland/waybar/.config/waybar/style-live.css

# Atomic-write temp files from theme-render (mktemp <target>.tmp-theme.XXXXXX).
# Only ever present if a render is hard-killed mid-write; never tracked.
*.tmp-theme.*
