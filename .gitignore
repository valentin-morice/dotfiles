# Secret — kept on disk for runtime (read via the conky symlink), never committed
conky/.config/conky/imap.env
# Compiled Go helper (built to ~/.local/bin/conky-mail-label, not tracked)
conky/.config/conky/imap/imap
# Flameshot GUI-managed state (rewrites savePath itself; machine-specific, not portable)
flameshot/.config/flameshot/flameshot.ini

# Generated by theme-render from ~/.config/theme/palette.sh; never tracked.
polybar/.config/polybar/colors.ini
i3/.config/i3/colors.conf
alacritty/.config/alacritty/colors.toml
rofi/.config/rofi/colors.rasi
conky/.config/conky/colors.lua
