{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "right": 3
    },
    "color": {
      "1": "#6b7680",
      "2": "#6b7680"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#2f6fb3",
      "title": "#2f6fb3"
    },
    "percent": {
      "color": {
        "green": "#b5790a",
        "yellow": "#b5790a",
        "red": "#b5790a"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#2f6fb3",
        "at": "#2f6fb3",
        "host": "#2f6fb3"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#1d2329"
    },
    "os",
    "kernel",
    "host",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "font",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
