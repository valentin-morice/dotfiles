// waybar config — rendered by theme-render, though it now interpolates NOTHING:
// this file contains no colour at all, so it is byte-identical in every theme.
//
// It used to carry "frozen" palette values (THEME_accent_fixed/_muted_fixed) as
// inline pango foregrounds, chosen precisely because they were equal in light
// and dark. That is gone: the icons follow the theme foreground now, so every
// colour — including each module's muted/alert state — lives in style.css,
// which waybar live-applies via reload_style_on_change with no reset/flicker.
// This config has no in-place reload, so keeping colour out of it entirely is
// what avoids the flickery SIGUSR2 restart on a theme switch.
//
// Consequence worth remembering: pango markup beats CSS colour. Re-adding an
// inline foreground to any span below would pin that icon to one colour and
// break the theme switch — and, on battery, would survive on top of the urgent
// red fill and be unreadable. There are no spans at all now: see ICONS.
//
// ICONS: one family only — Google's Material Symbols Outlined (the variable
// font from github.com/google/material-design-icons), which replaced the Nerd
// Font Material Design (md-*) set. md was community-drawn on inconsistent
// scales, so every glyph needed its own size% span to look even; Material
// Symbols draws every icon on one 24dp grid, so there is ONE size for all of
// them and it lives in style.css (font-family + font-size + font-weight on the
// icon modules), not here. Outlined, Rounded and Sharp share every codepoint,
// so the style is a CSS-only choice.
//
// That CSS font-family is load-bearing, not cosmetic: Material Symbols'
// codepoints (U+E000-U+F8FF) sit in the Private Use Area the Nerd Font also
// fills (powerline, seti, devicons ...), so with the bar's JetBrainsMono first
// in the stack these characters would render as unrelated Nerd Font glyphs.
// Anything that emits a Material Symbols glyph must be a module listed in that
// style.css rule.
//
// Codepoints come from the font's own .codepoints file (name -> hex). The
// literal glyphs below are that PUA, so they look blank or wrong in an editor
// without the font — the name is noted beside each one.
//
// To add an icon: look its codepoint up in that file and add the module to the
// style.css icon rule. No sizing maths any more.
{
    // Watch style.css and hot-apply CSS changes in place (no widget reset) —
    // this is what makes a theme switch recolour smoothly instead of flickering.
    "reload_style_on_change": true,

    "layer": "top",
    "position": "top",
    // 32px visible bar, picked over 34 (the old height) and 30 after trying
    // all three live. With the ~15px icons that is an icon:bar ratio of ~0.47,
    // between GNOME's top bar (0.5) and a notched MacBook's menu bar (0.43).
    // 40 = the 32px bar + an 8px transparent strip for its drop shadow (see
    // window#waybar > box in style.css); the visible bar is still 32.
    "height": 40,
    // macOS menu-bar layout: workspaces alone on the left, every status icon
    // collected on the right, clock last (right-most). Nothing is centred any
    // more, so the old custom/clockpad counterweight is gone.
    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    // Ordered like macOS: transient indicators, tray, then the fixed system
    // icons, then the clock. tray still sits left of the fixed icons so a
    // newly-added tray icon grows leftward instead of shoving them.
    //
    // custom/mail is the one transient module deliberately kept OUT of that
    // left group: it heads the fixed icon row (mail, idle, brightness, ...) so
    // the envelope reads as a system icon instead of being mistaken for a tray
    // icon. The cost is accepted: unlike the other transients, mail appearing
    // does shove the icons to its right (idle_inhibitor onward) by its width.
    //
    // The fixed row is grouped by what each icon is ABOUT, left to right:
    //   screen        idle_inhibitor, backlight   (does it sleep, how bright)
    //   audio         pulseaudio                  (the one you scroll most)
    //   connectivity  bluetooth, network
    //   power         custom/powerprofile, battery (spend vs. what's left)
    //   clock
    // wifi / battery / clock end the row in the order every desktop uses, so
    // they're found without looking. Spacing stays uniform: a wider gap between
    // groups was tried and rejected, so the grouping is carried by adjacency
    // alone.
    "modules-right": ["sway/mode", "custom/recording", "custom/dnd", "custom/nightlight", "tray", "custom/mail", "idle_inhibitor", "backlight", "pulseaudio", "bluetooth", "network", "custom/powerprofile", "battery", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        // DYNAMIC: no persistent-workspaces, so a workspace appears when it has
        // a window and disappears when it empties. The bar therefore changes
        // width as you work — that is the point, not a regression.
        //
        // This only changes what is DISPLAYED. Which screen a workspace opens on
        // is sway's own pinning (`workspace $wsN output ...` in the sway config),
        // which is untouched, so the docked layout still behaves the same.
        //
        // all-outputs stays at its default of false: each bar lists only the
        // workspaces living on its own output, so the unfocused screen's bar has
        // no .focused button at all. That absence, plus the .visible fill in
        // style.css, is the "which screen am I typing on" cue.
        "all-outputs": false,
        // Pointer cursor over the buttons. Waybar only shows the hand by itself
        // for modules with an on-click (or a built-in click, like
        // idle_inhibitor); workspace clicks are handled by the buttons, so the
        // module has to ask for it. true = Gdk HAND2, set once on the module's
        // window; the buttons' input windows inherit it.
        "cursor": true
    },

    // Binding-mode indicator (e.g. "resize"); auto-hidden in the default mode,
    // mirroring polybar's internal/i3 mode label. Accent-coloured like the
    // other text labels, hence rendered from the palette.
    "sway/mode": {
        "format": "{}",
        "tooltip": false
    },

    "clock": {
        "interval": 10,
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // Power-profile icon — bolt / contrast / eco for performance / balanced /
    // power-saver; click opens the rofi-profile card panel. Refreshed instantly by
    // rofi-profile (pkill -RTMIN+11 waybar); interval is the external-change
    // fallback. Colour is theme-varying, so it lives in style.css.
    "custom/powerprofile": {
        "exec": "$HOME/.local/bin/waybar-powerprofile",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "on-click": "$HOME/.local/bin/rofi-profile"
    },

    // Sits at the head of the fixed icon row in modules-right (before
    // idle_inhibitor), not with the other transient indicators left of the
    // tray — see the note there.
    "custom/mail": {
        "exec": "$HOME/.local/bin/waybar-mail",
        "interval": 5,
        "return-type": "json"
    },

    // Signal-driven status icons — each prints a bare glyph when active and
    // nothing (module hidden) when not, so they add no gap when idle and the
    // rendered config stays theme-invariant. Refreshed on demand: screenrecord
    // sends RTMIN+8, the DND bind RTMIN+9, nightlight-toggle RTMIN+10.
    // These labels only appear while active, which makes them ideal click
    // targets to turn the thing back off (helpers already exist).
    "custom/recording": {
        "exec": "$HOME/.local/bin/waybar-recording",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "$HOME/.local/bin/screenrecord"
    },
    "custom/dnd": {
        "exec": "$HOME/.local/bin/waybar-dnd",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "$HOME/.local/bin/dnd-toggle"
    },
    "custom/nightlight": {
        "exec": "$HOME/.local/bin/waybar-nightlight",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "$HOME/.local/bin/nightlight-toggle"
    },

    // Click-to-caffeinate: inhibits the swayidle timers while activated.
    "idle_inhibitor": {
        "format": "{icon}",
        // Distinct ICON per state (not just colour) so the state is readable at a
        // glance and for colour-blind users. These name the thing being
        // controlled rather than a metaphor for it: "bedtime off" while idle is
        // inhibited, plain "bedtime" for normal idle/lock behaviour.
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip-format-activated": "Idle inhibitor: On",
        "tooltip-format-deactivated": "Idle inhibitor: Off"
    },

    "pulseaudio": {
        "format": "",
        "format-muted": "",
        "tooltip-format": "Volume: {volume}%",
        // Scroll to change volume, click to mute — reuse the same helpers the
        // XF86Audio keys use (so the OSD toast + 100% clamp behave identically).
        "on-scroll-up": "$HOME/.local/bin/volume-notify up",
        "on-scroll-down": "$HOME/.local/bin/volume-notify down",
        "on-click": "$HOME/.local/bin/toggle-audio-mute"
    },

    // Screen backlight. No "device" key on purpose — waybar autodetects the sole
    // entry in /sys/class/backlight, which keeps this portable the same way the
    // battery module stays adapter-agnostic (here it'd be the amdgpu-specific
    // "amdgpu_bl1"). udev-driven, so no polling interval is needed.
    "backlight": {
        // Level ramp: brightness_low / _medium / _high (the sun's centre fills
        // up). waybar splits percent into len() equal buckets: 0-32, 33-65,
        // 66-100.
        "format": "{icon}",
        "format-icons": ["", "", ""],
        "tooltip-format": "Brightness: {percent}%",
        // Scroll to adjust — reuses the helper the XF86MonBrightness keys call,
        // so the OSD toast and the 5% floor behave identically either way.
        "on-scroll-up": "$HOME/.local/bin/brightness-notify up",
        "on-scroll-down": "$HOME/.local/bin/brightness-notify down"
    },

    // Wi-Fi and Bluetooth are waybar modules again (nm-applet and blueman are
    // uninstalled, so the tray no longer carries them — it's for real graphical
    // apps only now). Click opens a rofi list menu in the same look as the other
    // menus: networkmanager_dmenu (wifi picker, config in
    // ~/.config/networkmanager-dmenu) and rofi-bluetooth (devices, pairing with
    // its own agent). $mod+n / $mod+b open the same two menus.
    "network": {
        "interval": 5,
        // Signal-strength ramp in the dot-and-arcs style: wifi_1_bar (the dot),
        // wifi_2_bar (dot + one arc), wifi (full). Material only draws this
        // family in three steps, so waybar's len() buckets are 0-32 / 33-65 /
        // 66-100. Every state below stays in the same family — the slashed arcs
        // for disconnected, full arcs for the brief linked state — so the icon
        // never switches drawing style (the framed-wedge set was tried first).
        // Disconnected is signal_wifi_off, the slashed WEDGE, not wifi_off (the
        // slashed arcs): same drawing style as the ramp, so losing the link
        // changes the state, not the icon family.
        "format-wifi": "{icon}",
        "format-icons": ["", "", ""],
        "format-ethernet": "",
        "format-disconnected": "",
        // "linked" = carrier up but no IPv4 (waybar only looks at IPv4 by
        // default). Happens on IPv6-only networks like an iPhone hotspot;
        // without this the built-in fallback prints "wlp1s0 (No IP)" as text.
        // It also flashes by for a moment on every connect/disconnect, so it
        // must stay in the ramp's dot-and-arcs family (full `wifi`).
        "format-linked": "",
        "tooltip-format-wifi": "Network: {essid} ({signalStrength}%)",
        "tooltip-format-linked": "Network: {ifname} (no IPv4)",
        "tooltip-format-ethernet": "Network: {ifname}",
        "tooltip-format-disconnected": "Network: Disconnected",
        "on-click": "networkmanager_dmenu"
    },

    "bluetooth": {
        // On/off is carried by a DIFFERENT GLYPH (plain rune vs slashed) plus the
        // muted colour, rather than the words ON/OFF — the bar is icon-only now.
        "format": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "",
        "tooltip-format": "Bluetooth: On",
        "tooltip-format-connected": "Bluetooth: {device_alias}",
        "tooltip-format-off": "Bluetooth: Off",
        "tooltip-format-disabled": "Bluetooth: Off",
        "on-click": "$HOME/.local/bin/rofi-bluetooth"
    },

    "battery": {
        // No hardcoded "bat"/"adapter": waybar autodetects the first battery +
        // adapter, so this stays portable (adapters vary: AC / AC0 / ADP1 ...).
        "interval": 5,
        // Stamps the .critical CSS class under 10%, which style.css turns red —
        // the one icon in the bar that changes colour. The old "warning": 20 step
        // is gone with the amber it drove; a threshold that styles nothing would
        // just be dead config.
        //
        // "below-cap"/"at-cap" exist only to pin the display at the 81 charge cap
        // (see ~/.local/bin/battery-charge-cap). The EC doesn't stop at the same
        // spot every time — it settles anywhere from ~79.3% to ~81.x%, so the
        // floored capacity read 79 one day and 81 the next. While parked on AC
        // (not charging) within 79-82, the *-at-cap entries below show a flat
        // 80% and pin the glyph to battery_android_6, the ramp step 80
        // lands on, so the icon can't flip at a bucket edge either. States take the LOWEST threshold >= capacity, so
        // "below-cap" fences 11-78 off from "at-cap"; neither is styled in CSS.
        "states": { "critical": 10, "below-cap": 78, "at-cap": 82 },
        "tooltip-format": "Battery: {capacity}%",
        // Waybar lowercases the sysfs status and hyphenates it ("Not charging" ->
        // not-charging). The Z13 reports "Not charging" at the cap; plugged/full
        // are covered too in case a kernel/EC update renames it.
        "tooltip-format-not-charging-at-cap": "Battery: 80%",
        "tooltip-format-plugged-at-cap": "Battery: 80%",
        "tooltip-format-full-at-cap": "Battery: 80%",
        "format-not-charging-at-cap": "",
        "format-plugged-at-cap": "",
        "format-full-at-cap": "",
        // Material's Android-style battery, SOLID variant (battery_android_*):
        // the fill sits flush against the outline. The FRAME variant
        // (battery_android_frame_*) was dropped: it floats its fill inside the
        // outline with a sub-pixel inset, which at 18px (0.75px per design unit)
        // anti-aliases unevenly — one gap crisp, the other smeared, so the fill
        // looked off-centre, and no font size fixed it in the live bar.
        // Trade-off: this set has no charging ramp, and its bolt and alert
        // glyphs are outlines, so plugging in makes the icon lighter.
        //
        // battery_android_0 is skipped so the ramp keeps seven steps; below 10%
        // the critical alert glyph takes over anyway. Low -> high; waybar splits
        // capacity into len() equal buckets, so the seven steps are 14 wide
        // (0-13, 14-27, ... 70-83, 84+).
        "format-icons": {
            // Keyed by status. There is a single charging cell (no level ramp),
            // so charging is one glyph at every capacity.
            "charging": [""],
            "default": ["", "", "", "", "", "", ""]
        },
        "format": "{icon}",
        // Under 10% the glyph becomes battery_android_alert, on top of the red that
        // style.css gives .critical — the alarm is carried by shape as well as
        // colour, like every other state in the bar.
        //
        // Precedence is format-<status>-<state> > format-<state> > format-<status>,
        // so without format-charging-critical a CHARGING battery under 10% would
        // fall back to format-critical and show the alert cell instead of the
        // charging one. That entry is what keeps "plugged in" readable at low
        // charge.
        "format-critical": "",
        "format-charging-critical": "{icon}"
    },

    // Positioned before the fixed icon row in modules-right (not at the far
    // right): the tray is the only right-side module whose width changes at
    // runtime, so keeping the fixed icons anchored to its right stops them
    // layout-shifting when an icon appears — the tray grows leftward instead.
    "tray": {
        // 12, not 6: every other module is separated from its neighbour by its
        // own 6px left padding plus the neighbour's 6px right padding = 12px.
        // The tray draws its icons itself, so this spacing is the ONLY gap
        // between them — at 6 they would sit at half the pitch of the rest of
        // the bar and the tray would read as a tighter cluster. 12 makes one
        // even row.
        "spacing": 12,
        "icon-size": 19,
        // Pointer cursor over the tray icons. Every item is clickable, but its
        // clicks go to the item itself, not the module, so waybar never shows
        // the hand here unless asked (see sway/workspaces).
        "cursor": true
    }
}
