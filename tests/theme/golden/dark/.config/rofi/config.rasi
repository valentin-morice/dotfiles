/* rofi config + theme — RENDERED by theme-render from
   templates/rofi.rasi.tmpl into ~/.config/rofi/config.rasi. Do NOT edit the
   generated file; edit this template (layout) or the palettes (colours:
   palettes/{light,dark}.sh). rofi reads #RRGGBB directly, so the plain
   ${THEME_*} forms are used here (no _bare/ff hack, unlike fuzzel).

   Faithful port of the retired fuzzel launcher look: JetBrainsMono 11.5, 2px
   border (radius 0), "❯" prompt, "Search" placeholder, 11 visible rows, no
   icons, 720px wide. rofi is spawned fresh per keypress (no daemon), so it
   re-reads this file on every launch — theme-render needs NO reload hook for
   rofi, unlike the daemons it also renders.

   Font size tracks alacritty's (also 11.5) — by-eye values, not a computed
   match; see the note in alacritty.toml.

   drun is $mod+d; the ~/.local/bin/rofi-* menus drive rofi in -dmenu mode and
   each passes its own "<name> ❯" via -p. */

configuration {
    font:                "JetBrainsMono Nerd Font 11.5";
    /* show-icons stays off by default so the clip/profile dmenu wrappers have
       no empty icon column; the drun bind and rofi-window flip it on with
       -show-icons (drun from .desktop icons, rofi-window from per-row app_id
       icons). icon-theme follows the palette's Papirus variant so app icons
       track light/dark. */
    show-icons:          false;
    icon-theme:          "Papirus-Dark";
    terminal:            "alacritty";
    /* drun search fields mirror fuzzel's fields=name,generic,keywords */
    drun-match-fields:   "name,generic,keywords";
    drun-display-format: "{name}";
    /* drun mode ignores -p, so its "drun ❯" prompt comes from display-drun; the
       dmenu wrappers still get their "<name> ❯" from -p. */
    display-drun:        "drun ❯";
}

* {
    bg:        #0d0d0d;
    bg-alt:    #141414;
    bg-sel:    #1c1c1c;
    fg:        #d4d4d4;
    accent:    #5294e2;
    prompt-fg: #e0a552;
    muted:     #6e6e6e;
    border-c:  #1f1f1f;
    border-med: #444444;

    background-color: transparent;
    text-color:       @fg;
}

/* Dimmed backdrop: the window covers the whole focused output with translucent
   black, so everything behind the menu (bar included) is shaded while it is
   open. Mainline sway can't blur (see the SwayFX notes), so this is a plain dim
   — no screenshot, no launch cost. The visible card is mainbox, centred by the
   expanding pad boxes around it: vpad above/below the row, hpad either side.
   Unknown child names become plain boxes in rofi, so they need no other setup.

   The card menus (rofi-card-theme.sh) size and style mainbox, not window, for
   the same reason — window is always the full-output dim now. */
window {
    fullscreen:       true;
    border:           0;
    padding:          0px;
    background-color: rgba(0, 0, 0, 0.35);
    orientation:      vertical;
    children:         [ vpad, row, vpad ];
}

row {
    orientation: horizontal;
    expand:      false;
    children:    [ hpad, mainbox, hpad ];
}

vpad, hpad {
    expand: true;
}

mainbox {
    expand:           false;
    /* fixed 720px — the width fuzzel's ~72-char setting was tuned to match */
    width:            720px;
    border:           2px;
    border-color:     @border-c;
    border-radius:    0px;
    background-color: @bg;
    padding:          14px 16px;
    spacing:          10px;
    children:         [ inputbar, listview ];
}

inputbar {
    spacing:  8px;
    border:   0;
    children: [ prompt, entry ];
}

/* the "<name> ❯" text comes from each menu's -p (drun's from display-drun) */
prompt {
    text-color: @prompt-fg;
}

entry {
    placeholder:       "Search";
    placeholder-color: @muted;
    text-color:        @fg;
}

listview {
    lines:        11;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      2px;
    border:       0;
    background-color: transparent;
}

/* row pitch ~34px: 6px vertical padding + the font's line box, matching the
   metric fuzzel's line-height=26 was reverse-engineered from. */
element {
    padding:          6px 10px;
    spacing:          10px;   /* gap between icon and text (drun + window) */
    border-radius:    0px;
    background-color: transparent;
    text-color:       @fg;
}

/* Only rendered when -show-icons is on (drun + rofi-window). Hidden for the
   remaining dmenu wrappers (clip/profile), so `spacing` above adds no leading
   gap there. */
element-icon {
    size:             22px;
    vertical-align:   0.5;
    background-color: transparent;
}

/* State-qualified selectors are REQUIRED: rofi's default theme defines
   `element alternate.normal` (a cream row background) and a bare `element
   selected` is less specific, so without these the default cream/dashed styling
   leaks into every list (drun, clip, window, profile). */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-sel;
    text-color:       @accent;
}

/* .active rows (rofi -a), used by the wifi picker (networkmanager-dmenu) to
   mark the connected network. Same leak as above: without these the default
   theme paints active rows cream. Accent text on the normal background marks
   "current"; selecting it looks like any other selected row. */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @accent;
}
element selected.active {
    background-color: @bg-sel;
    text-color:       @accent;
}

/* matched-substring highlight (fuzzel's `match` colour). rofi's `highlight`
   property takes a literal colour, not an @reference — so the palette value is
   inlined here (still re-rendered on every theme-switch). */
element-text {
    background-color: transparent;
    text-color:       inherit;
    /* centre the label against the (taller) icon — element-icon is already
       vertical-align 0.5, so without this the two sit off-centre (flex
       align-items: center). Affects every iconned menu: drun, window, clip. */
    vertical-align:   0.5;
    highlight:        bold #5294e2;
}
